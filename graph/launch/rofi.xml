<sect1 id="rofi" xreflabel="Rofi-&rofi-version;">
  <?dbhtml filename="rofi.html"?>

  <title>Rofi-&rofi-version;</title>

  <indexterm zone="rofi">
    <primary sortas="a-rofi">Rofi</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Rofi</title>

    <para>
      Rofi tilbyr en programstarter for X Window-systemet. Den kan starte 
      programmer som finnes i 
      <envar>$PATH</envar>, som <command>firefox</command>. Den kan også 
      starte applikasjoner fra <filename
      class="extension">.desktop</filename> filer i <filename
      class="directory">/usr/share/applications</filename>, <filename
      class="directory">~/.local/share/applications</filename>, og andre stier, 
      som for eksempel
      <filename>/usr/share/applications/firefox.desktop</filename>. Denne 
      versjonen støtter nå Wayland.
    </para>

    &build-use-internet;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&rofi-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Rofi Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/x/gdk-pixbuf.html">gdk-pixbuf</ulink>,
      <ulink url="&blfs-svn;/general/glib2.html">GLib2</ulink>,
      <ulink url="&blfs-svn;/x/libxcb.html">libxcb</ulink>,
      <ulink url="&blfs-svn;/general/libxkbcommon.html">libxkbcommon</ulink>,
      <ulink url="&blfs-svn;/x/pango.html">Pango</ulink> (with
      <ulink url="&blfs-svn;/x/cairo.html">Cairo</ulink>),
      <ulink url="&blfs-svn;/x/startup-notification.html">startup-notification</ulink>, og
      <ulink url="&blfs-svn;/x/xcb-utilities.html">XCB Utilities</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/x/hicolor-icon-theme.html">hicolor-icon-theme</ulink>,
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>, og
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="xcb-imdkit"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Rofi</title>

    <para>
      Installer Rofi ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          rofi, rofi-sensible-terminal, og rofi-theme-selector
        </seg>
        <seg>
          Ingen
        </seg>
        <seg>
          /usr/include/rofi og
          /usr/share/rofi/themes
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="rofi-bin">
        <term><command>rofi</command></term>
        <listitem>
          <para>
            er en X11 applikasjonsstarter
          </para>
          <indexterm zone="rofi rofi-bin">
            <primary sortas="b-rofi-bin">rofi</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="rofi-sensible-terminal">
        <term><command>rofi-sensible-terminal</command></term>
        <listitem>
          <para>
            starter standardterminalen
          </para>
          <indexterm zone="rofi rofi-sensible-terminal">
            <primary sortas="b-rofi-sensible-terminal">rofi-sensible-terminal</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="rofi-theme-selector">
        <term><command>rofi-theme-selector</command></term>
        <listitem>
          <para>
            endrer temaet som brukes til <command>rofi</command> sin UI
          </para>
          <indexterm zone="rofi rofi-theme-selector">
            <primary sortas="b-rofi-theme-selector">rofi-theme-selector</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

