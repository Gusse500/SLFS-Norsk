<sect1 id="wofi" xreflabel="Wofi-&wofi-version;">
  <?dbhtml filename="wofi.html"?>

  <title>Wofi-&wofi-version;</title>

  <indexterm zone="wofi">
    <primary sortas="a-wofi">Wofi</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Wofi</title>

    <para>
      Wofi tilbyr en applikasjonsstarter for Wayland komposisjoner. 
      Den har mesteparten av den samme 
      funksjonaliteten som <xref linkend="rofi"/>.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&wofi-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Wofi Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/x/gdk-pixbuf.html">gdk-pixbuf</ulink>,
      <ulink url="&blfs-svn;/general/glib2.html">GLib2</ulink>,
      <ulink url="&blfs-svn;/x/gtk3.html">GTK-3</ulink>,
      <ulink url="&blfs-svn;/x/pango.html">Pango</ulink> (med
      <ulink url="&blfs-svn;/x/cairo.html">Cairo</ulink>), og
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Wofi</title>

    <para>
      Installer Wofi ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

  </sect2>

