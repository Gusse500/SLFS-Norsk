  <sect2 role="package">
    <title>Introduksjon til libXp</title>

    <para>
      libXp pakken inneholder et bibliotek som implementerer X Print protokollen.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libxp-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  <bridgehead renderas="sect3">libXp Avhengigheter</bridgehead>

  <bridgehead renderas="sect4">Påkrevd</bridgehead>
  <para role="required">
    <xref linkend="printproto"/> og
    <ulink url="&blfs-svn;/x/x7lib.html">Xorg Biblioteker</ulink>
  </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libXp</title>

    <para>
      Installer libXp ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure $XORG_CONFIG --docdir=$XORG_PREFIX/share/doc/libXp-&libxp-version; &amp;&amp;
make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

