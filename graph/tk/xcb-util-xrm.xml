  <sect2 role="package">
    <title>Introduksjon til xcb-util-xrm</title>

    <para>
      Pakken xcb-util-xrm tilbyr XCB verktøyfunksjoner 
      for X Ressursbehandler.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&xcb-util-xrm-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">xcb-util-xrm Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/x/util-macros.html">util-macros</ulink>,
      <ulink url="&blfs-svn;/x/xcb-util.html">xcb-util</ulink>, og
      <ulink url="&blfs-svn;/x/x7lib.html">Xorg Biblioteker</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av xcb-util-xrm</title>

    <para>
      Installer xcb-util-xrm ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr --disable-static &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

