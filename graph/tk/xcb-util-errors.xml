<sect1 id="xcb-util-errors" xreflabel="xcb-util-errors-&xcb-util-errors-version;">
  <?dbhtml filename="xcb-util-errors.html"?>

  <title>xcb-util-errors-&xcb-util-errors-version;</title>

  <indexterm zone="xcb-util-errors">
    <primary sortas="a-xcb-util-errors">xcb-util-errors</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til xcb-util-errors</title>

    <para>
      Pakken xcb-util-errors inneholder XCB verktøyfunksjoner 
      som gir menneskelig lesbare X11 feil.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&xcb-util-errors-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">xcb-util-errors Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/x/libxcb.html">libxcb</ulink> og
      <ulink url="&blfs-svn;/x/xcb-proto.html">xcb-util</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av xcb-util-errors</title>

    <para>
      Installer xcb-util-errors ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure $XORG_CONFIG &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
