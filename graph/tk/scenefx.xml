<sect1 id="scenefx" xreflabel="SceneFX-&scenefx-version;">
  <?dbhtml filename="scenefx.html"?>

  <title>SceneFX-&scenefx-version;</title>

  <indexterm zone="scenefx">
    <primary sortas="a-scenefx">SceneFX</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til SceneFX</title>

    <para>
      SceneFX gir Wlroots baserte Wayland komposisjoner fantastiske 
      overflategjengivelsesfunksjoner i stedet for Wlroots scene API.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&scenefx-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">scenefx Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/x/libdrm.html">libdrm</ulink>,
      &gbm;,
      <ulink url="&blfs-svn;/x/glslang.html">Glslang</ulink>,
      &wayland-gl;,
      <ulink url="&blfs-svn;/general/pixman.html">Pixman</ulink>,
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>,
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>,
      og <xref linkend="wlroots"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av scenefx</title>

    <para>
      Installer scenefx ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
