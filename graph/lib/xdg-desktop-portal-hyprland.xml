  <sect2 role="package">
    <title>Introduksjon til xdg-desktop-portal-hyprland</title>

    <para>
      Pakken xdg-desktop-portal-hyprland tilbyr portalens bakende for 
      Hyprland.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&xdg-desktop-portal-hyprland-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">xdg-desktop-portal-hyprland Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>,
      <xref linkend="hyprlib"/>,
      <ulink url="&blfs-svn;/x/libdrm.html">libdrm</ulink>,
      &opengl;,
      <ulink url="&blfs-svn;/multimedia/pipewire.html">Pipewire</ulink>,
      <ulink url="&blfs-svn;/x/qt6.html">Qt-6</ulink>,
      <xref linkend="sdbus-cpp"/>,
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>,
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>, og
      <ulink url="&blfs-svn;/x/xdg-desktop-portal.html">xdg-desktop-portal</ulink>
    </para>

    <bridgehead renderas="sect4">Påkrevd (Kjøretid)</bridgehead>
    <para role="runtime">
      <xref linkend="hyprland"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/inih.html">inih</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri (Kjøretid)</bridgehead>
    <para role="optional">
      <xref role="runtime" linkend="grim"/> og
      <xref role="runtime" linkend="slurp"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av xdg-desktop-portal-hyprland</title>

    <para>
      Installer xdg-desktop-portal-hyprland ved å kjøre følgende kommandoer:
    </para>

<screen revision="sysv"><userinput>rm -rf subprojects           &amp;&amp;
mkdir build                  &amp;&amp;
cd    build                  &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D SYSTEMD_SERVICES=OFF      \
      -G Ninja ..            &amp;&amp;

ninja</userinput></screen>

<screen revision="systemd"><userinput>rm -rf subprojects           &amp;&amp;
mkdir build                  &amp;&amp;
cd    build                  &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D SYSTEMD_SERVICES=ON       \
      -G Ninja ..            &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <command>rm -rf subprojects</command>: Denne kommandoen fjerner kildekode 
      fra leverandøren.
    </para>

  </sect2>

