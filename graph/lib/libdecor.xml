<sect1 id="libdecor" xreflabel="libdecor-&libdecor-version;">
  <?dbhtml filename="libdecor.html"?>

  <title>libdecor-&libdecor-version;</title>

  <indexterm zone="libdecor">
    <primary sortas="a-libdecor">libdecor</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libdecor</title>

    <para>
      libdecor pakken inneholder et bibliotek som hjelper Wayland klienter med 
      å tegne vindusdekorasjoner på klientsiden.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&libdecor-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libdecor Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/x/pango.html">Pango</ulink>
      (med <ulink url="&blfs-svn;/x/cairo.html">Cairo</ulink>),
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>, og
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/dbus.html">D-Bus</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/x/gtk3.html">GTK-3</ulink>,
      <ulink url="&blfs-svn;/general/libxkbcommon.html">libxkbcommon</ulink>, og
      &opengl; (med EGL)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libdecor</title>

    <para>
      Installer libdecor ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr       \
            --buildtype=release \
            -D demo=false       \
            -D gtk=disabled     \
            .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

    <para>
      <parameter>-D demo=false</parameter>: Denne parameteren deaktiverer 
      bygging av demoer. Fjern den hvis du installerte de valgfrie avhengighetene.
    </para>

    <para>
      <parameter>-D gtk=disabled</parameter>: Denne parameteren deaktiverer 
      byggingen av GTK-3 programtillegget. Fjern den hvis du har installert den.
      <ulink url="&blfs-svn;/x/gtk3.html">GTK-3</ulink>.
    </para>

  </sect2>

