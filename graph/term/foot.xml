<sect1 id="foot" xreflabel="foot-&foot-version;">
  <?dbhtml filename="foot.html"?>

  <title>foot-&foot-version;</title>

  <indexterm zone="foot">
    <primary sortas="a-foot">foot</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til foot</title>

    <para>
      Foot pakken tilbyr en 
      Wayland terminalemulator.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&foot-download;"/>
        </para>
      </listitem>
    </itemizedlist>

<!--
    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="&dl-root;/foot/foot-&foot-version;-const_strchr-1.patch"/>
        </para>
      </listitem>
    </itemizedlist>
-->

    <bridgehead renderas="sect3">foot Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/fontconfig.html">fontconfig</ulink>,
      <ulink url="&blfs-svn;/general/libxkbcommon.html">libxkbcommon</ulink>,
      <ulink url="&blfs-svn;/general/pixman.html">Pixman</ulink>,
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>, og
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="fcft"/> (hvis den ikke er bygget, vil den bli lastet ned),
      <ulink url="&blfs-svn;/general/harfbuzz.html">HarfBuzz</ulink>, og
      <xref linkend="tllist"/> (hvis den ikke er bygget, vil den bli lastet ned)
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="libutempter"/>,
      <xref linkend="scdoc"/>, og
      <ulink url="&arch-pkgs;/extra/x86_64/utf8proc/">utf8proc</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av foot</title>

<!--
    &glibc243-const;

<screen role="pre"><userinput>patch -Np1 -i ../foot-&foot-version;-const_strchr-1.patch</userinput></screen>
-->

    <para>
      Først må du sørge for at dokumentasjonsmappen er versjonert:
    </para>

<screen><userinput>sed -e "s/install_dir: join_paths(get_option('datadir'), 'doc', 'foot'/&amp; + '-' + meson.project_version()/" \
    -i meson.build</userinput></screen>

    <para>
      Installer foot ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>ninja test</command>
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

  </sect2>

  <sect2 role="configuration">
    <title>Konfigurere foot</title>

    <sect3 id="foot-config">
      <title>Konfigurasjonsfiler</title>
      <para>
        <filename>~/.config/foot/foot.ini</filename>. Standardversjonen 
        er i <filename class="directory">/etc/xdg/foot</filename> og vil 
        ikke bli brukt og må kopieres til
        <filename class="directory">~/.config/foot</filename>.
      </para>

      <indexterm zone="foot foot-config">
        <primary sortas="e-AA.config">~/.config/foot/foot.ini</primary>
      </indexterm>

    </sect3>

    <sect3><title>Konfigurasjonsinformasjon</title>

      <para>
        Opprett konfigurasjonsfilen:
      </para>

<screen><userinput>mkdir -pv ~/.config/foot &amp;&amp;
cp /etc/xdg/foot/foot.ini ~/.config/foot</userinput></screen>

      <para>
        Nå kan du sjekke filen og gjøre eventuelle endringer du synes er passende.
      </para>

    </sect3>

  </sect2>

