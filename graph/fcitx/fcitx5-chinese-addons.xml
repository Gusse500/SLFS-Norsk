<sect1 id="fcitx5-chinese-addons" xreflabel="Fcitx5-chinese-addons-&fcitx5-chinese-addons-version;">
  <?dbhtml filename="fcitx5-chinese-addons.html"?>

  <title>Fcitx5-chinese-addons-&fcitx5-chinese-addons-version;</title>

  <indexterm zone="fcitx5-chinese-addons">
    <primary sortas="a-fcitx5-chinese-addons">Fcitx5-chinese-addons</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Fcitx5-chinese-addons</title>

    <para>
      Pakken Fcitx5-chinese-addons tilbyr kinesisk relaterte tillegg for 
      Fcitx 5, inkludert IME-er som tidligere ble inkludert i Fcitx 4.
    </para>

    &build-use-network;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&fcitx5-chinese-addons-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Fcitx5-chinese-addons Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/boost.html">Boost</ulink>,
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>,
      &ecm;,
      <xref linkend="fcitx5"/>,
      og <xref linkend="libime"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="fcitx5-lua"/>,
      <xref linkend="fcitx5-qt"/>. og
      <ulink url="&blfs-svn;/x/qt6.html">Qt-6</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/pst/cups.html">Cups</ulink>,
      <ulink url="&blfs-svn;/basicnet/curl.html">cURL</ulink>,
      <ulink url="https://github.com/BYVoid/OpenCC">OpenCC</ulink>, og
      <ulink url="&blfs-svn;/x/qtwebengine.html">QtWebEngine</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Fcitx5-chinese-addons</title>

    <para>
      Installer Fcitx5-chinese-addons ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -D CMAKE_SKIP_INSTALL_RPATH=ON \
      -D ENABLE_TEST=OFF             \
      -D ENABLE_OPENCC=OFF           \
      -D ENABLE_BROWSER=OFF          \
      -D ENABLE_CLOUDPINYIN=OFF      \
      -W no-author ..               &amp;&amp;

make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &cmake-skip-install-rpath;

    <para>
      <parameter>-D ENABLE_OPENCC=OFF</parameter>: Denne bryteren deaktiverer 
      bygging av chttrans verktøyet, som krever OpenCC og Boost. Fjern det hvis 
      du har installert OpenCC og Boost.
    </para>

    <para>
      <parameter>-D ENABLE_BROWSER=OFF</parameter>: Denne bryteren deaktiverer 
      bygging av den innebygde nettleseren, som krever QtWebEngine. Fjern den 
      hvis du har installert QtWebEngine.
    </para>

    <para>
      <parameter>-D ENABLE_CLOUDPINYIN=OFF</parameter>: Denne bryteren 
      deaktiverer bygging av pinyin tillegget i skyen, som krever cURL. Fjern 
      det hvis du har installert cURL.
    </para>

  </sect2>

