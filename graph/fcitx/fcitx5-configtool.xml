<sect1 id="fcitx5-configtool" xreflabel="Fcitx5-configtool-&fcitx5-configtool-version;">
  <?dbhtml filename="fcitx5-configtool.html"?>

  <title>Fcitx5-configtool-&fcitx5-configtool-version;</title>

  <indexterm zone="fcitx5-configtool">
    <primary sortas="a-fcitx5-configtool">Fcitx5-configtool</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Fcitx5-configtool</title>

    <para>
      Pakken Fcitx5-configtool tilbyr et brukervennlig 
      konfigurasjonsgrensesnitt for Fcitx.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&fcitx5-configtool-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Fcitx5-configtool Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>,
      &ecm;,
      <xref linkend="fcitx5"/>,
      <xref linkend="fcitx5-qt"/>,
      <ulink url="&blfs-svn;/general/iso-codes.html">ISO Codes</ulink>,
      <ulink url="&blfs-svn;/kde/frameworks6.html">KF6</ulink>, og
      <ulink url="&blfs-svn;/x/xkeyboard-config.html">XKeyboardConfig</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/kde/plasma-all.html">KDE Plasma</ulink> og
      <ulink url="&blfs-svn;/general/libxkbcommon.html">libxkbcommon</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Fcitx5-configtool</title>

    <para>
      Installer Fcitx5-configtool ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -D CMAKE_SKIP_INSTALL_RPATH=ON \
      -D ENABLE_KCM=OFF              \
      -W no-author ..               &amp;&amp;

make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &cmake-skip-install-rpath;

    <para>
      <parameter>-D ENABLE_KCM=OFF</parameter>: Denne bryteren deaktiverer 
      bygging av KDE Plasma integrasjon for Fcitx5-configtool. Fjern den hvis 
      du har installert de valgfrie avhengighetene.
    </para>

  </sect2>

