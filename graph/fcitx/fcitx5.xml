<sect1 id="fcitx5" xreflabel="Fcitx5-&fcitx5-version;">
  <?dbhtml filename="fcitx5.html"?>

  <title>Fcitx5-&fcitx5-version;</title>

  <indexterm zone="fcitx5">
    <primary sortas="a-fcitx5">Fcitx5</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Fcitx5</title>

    <para>
      Fcitx5 pakken tilbyr et utvidbart rammeverk for inndatametoder.
    </para>

    &build-use-network;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&fcitx5-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd undermodul:
          <ulink url="https://github.com/facebook/yoga/archive/&fcitx5-yoga;/yoga-&fcitx5-yoga;.tar.gz"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Fcitx5 Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>,
      <ulink url="&blfs-svn;/general/dbus.html">dbus</ulink>,
      &ecm;,
      <ulink url="&blfs-svn;/general/fmt.html">fmt</ulink>,
      <ulink url="&blfs-svn;/general/json-c.html">JSON-C</ulink>,
      <ulink url="&blfs-svn;/x/libxcb.html">libxcb</ulink>,
      <xref linkend="nlohmann-json"/>,
      og <xref linkend="xcb-imdkit"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/x/cairo.html">Cairo</ulink>,
      <xref linkend="cldr-emoji-annotation"/>,
      <ulink url="&blfs-svn;/general/enchant.html">enchant</ulink>,
      <ulink url="&blfs-svn;/x/gdk-pixbuf.html">gdk-pixbuf</ulink>,
      <ulink url="&blfs-svn;/general/iso-codes.html">ISO Codes</ulink>,
      <ulink url="&blfs-svn;/x/pango.html">Pango</ulink> (med
      <ulink url="&blfs-svn;/x/cairo.html">Cairo</ulink>), og
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/general/doxygen.html">doxygen</ulink> (til å 
      bygge dokumentasjonen)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Fcitx5</title>

    <para>
      Pakk ut yoga undermodulen på riktig sted:
    </para>

<screen><userinput>tar -xf ../yoga-&fcitx5-yoga;.tar.gz &amp;&amp;
mv yoga-* -T third_party/yoga</userinput></screen>

    <para>
      Installer Fcitx5 ved å kjøre følgende 
      kommandoer:
    </para>

    <warning><para>
      IKKE deaktiver testtilleggene med
      <option>-D ENABLE_TESTING_ADDONS=OFF</option>
      alternativet. Av en eller annen grunn er noen Fcitx inndatametoder 
      avhengige av disse, selv når testkoden er eksplisitt deaktivert.
    </para></warning>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -D CMAKE_SKIP_INSTALL_RPATH=ON \
      -D ENABLE_TEST=OFF             \
      -Wno-dev .. &amp;&amp;

make</userinput></screen>

    <para>
      Hvis du har sendt <option>-D ENABLE_DOC=ON</option> parameteren til CMake, 
      bygg dokumentasjonen ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>make doc</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

    <para>
      Hvis du har bygget dokumentasjonen, installer den som &root; bruker:
    </para>

<!-- install doesn't support recursive copy and there's no doc install
target... ugh -->
<screen role="root"><userinput>install -vdm755   /usr/share/doc/fcitx5-&fcitx5-version; &amp;&amp;
cp -rv doc/html/* /usr/share/doc/fcitx5-&fcitx5-version;</userinput></screen>

    <para>
      I noen skrivebordsmiljøer og de fleste vindusbehandlere vil ikke Fcitx 
      startes automatisk. Kjør følgende kommando som hver bruker du vil bruke 
      Fcitx for å unngå det:
    </para>

<!-- Probably not the best practice to put in XDG_CONFIG_HOME,
     but it works. -->
<screen><userinput>install -vDm644 /usr/share/applications/org.fcitx.Fcitx5.desktop -t ~/.config/autostart/</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &cmake-skip-install-rpath;

    <para>
      <option>-D ENABLE_DOC=ON</option>: Bruk denne bryteren hvis du vil bygge 
      dokumentasjonen (krever doxygen).
    </para>

  </sect2>

  <sect2 role="configuration">
    <title>Konfigurere Fcitx5</title>
    <sect3>
      <title>Konfigurasjonsinformasjon</title>
      <para>
        Mens denne pakken er installert, vil du ha en inndatamotor i tillegg 
        til pakken, for eksempel <xref
        linkend="fcitx5-anthy"/>. Videre bør du sørge for at du faktisk kan 
        bruke denne pakken. Les <ulink
        url="https://fcitx-im.org/wiki/Fcitx_5">Fcitx5 Wiki</ulink> for mer 
        informasjon om hvordan du konfigurerer det.
      </para>
    </sect3>
  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installed Programtillegg</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          comp-spell-dict, fcitx5, fcitx5-configtool, fcitx5-diagnose,
          fcitx5-remote, og fcitx5-wayland-launcher
        </seg>
        <seg>
          libFcitx5Config, libFcitx5Core, og libFcitx5Utils
        </seg>
        <seg>
          libclassicui, libclipboard, libdbus, libdbusfrontend, libemoji,
          libfcitx4frontend, libibusfrontend, libimselector, libkimpanel,
          libnotificationitem, libnotifications, libquickphrase, libspell,
          libtestfrontend, libtestim, libtestui, libunicode,
          libvirtualkeyboard, libwayland, libwaylandim, libxcb, og libxim
        </seg>
        <seg>
          /usr/include/Fcitx5, /usr/lib/fcitx5, /usr/share/fcitx5,
          /usr/share/doc/fcitx5-&fcitx5-version;, og flere under
          /usr/lib/cmake/Fcitx5*
        </seg>
      </seglistitem>
    </segmentedlist>

