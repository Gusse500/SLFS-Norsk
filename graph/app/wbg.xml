    <primary sortas="a-wbg">wbg</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til wbg</title>

    <para>
      Wbg pakken inneholder en 
      Wayland bakgrunnsbildesetter.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&wbg-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">wbg Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/pixman.html">Pixman</ulink>,
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>, og
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/libpng.html">libpng</ulink>,
      <ulink url="&blfs-svn;/general/libjpeg.html">libjpeg-turbo</ulink>,
      <ulink url="&blfs-svn;/general/libwebp.html">libwebp</ulink>,
      <ulink url="&blfs-svn;/general/libjxl.html">libjxl</ulink>, og
      <xref linkend="tllist"/> (hvis den ikke er bygget, vil den bli lastet ned)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon of wbg</title>

<!---
    <para>
      Først må du bruke en rettelse som unngår en feil om mulige uinitialiserte 
      verdier:
    </para>

<screen><userinput>sed 's/float t\[6\]/float t\[6\] = {0}/' \
  -i 3rd-party/nanosvg/src/nanosvg.h</userinput></screen>
-->

    <para>
      Installer wbg ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

  </sect2>

