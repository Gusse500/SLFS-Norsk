          es2tri,
          gears,
          glxgears,
          glxinfo,
          peglgears,
          tri,
          vkgears, og
          xeglgears
        </seg>
        <seg>
          Ingen
        </seg>
        <seg>
          /usr/share/mesa-demos
        </seg>
      </seglistitem>
    </segmentedlist>

