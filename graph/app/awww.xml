<sect1 id="awww" xreflabel="awww-&awww-version;">
  <?dbhtml filename="awww.html"?>

  <title>awww-&awww-version;</title>

  <indexterm zone="awww">
    <primary sortas="a-awww">awww</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til awww</title>

    <para>
      Pakken awww (Answer to your Wayland Wallpaper Woes) tilbyr en kraftig 
      bakgrunnsbilde daemon for Wayland, kontrollert under kjøring.
    </para>

    &build-use-internet;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&awww-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">awww Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/rust.html">Rustc</ulink>,
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>, og
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>

    <para role="optional">
      <ulink url="&blfs-svn;/multimedia/dav1d.html">dav1d</ulink> og
      <xref linkend="scdoc"/> (for å bygge manualsidene)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av awww</title>
    <para>
      Installer awww ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>cargo build --release</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>cargo test --release</command>.
    </para>

    <para>
      Hvis du installerte scdoc og ønsker å bygge manualsidene, 
      kjør følgende kommandoer:
    </para>
<screen><userinput>./doc/gen.sh</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm755 target/release/swww -t /usr/bin/ &amp;&amp;
install -vDm755 target/release/swww-daemon -t /usr/bin/</userinput></screen>

<!-- uncomment with next update -seal331 5th November 2025
<screen role="root"><userinput>install -vDm755 target/release/awww -t /usr/bin/ &amp;&amp;
install -vDm755 target/release/awww-daemon -t /usr/bin/ &amp;&amp;
ln -sfv /usr/bin/awww /usr/bin/swww &amp;&amp;
ln -sfv /usr/bin/awww-daemon /usr/bin/swww-daemon</userinput></screen> -->

    <para>
      Hvis du ønsker å installere skallkompletteringer, utfør de relevante 
      kommandoene for skallet/skallene dine som &root; bruker:
    </para>

<!-- awww also provides shell autocomplete files for a shell called "elvish".
     I have no clue what that shell is, let alone where does it store its
     autocomplete files. If someone figures that out feel free to add the
     install command for that shell here, the file is "completions/swww.elv".
     -seal331 4th November 2025 -->

<screen role="root"><userinput>install -vDm644 completions/swww.bash /usr/share/bash-completion/completions/swww
install -vDm644 completions/_swww -t /usr/share/zsh/site-functions/
install -vDm644 completions/swww.fish -t /usr/share/fish/vendor_completions.d/</userinput></screen>

<!-- uncomment with next update -seal331 5th November 2025
<screen role="root"><userinput>install -vDm644 completions/awww.bash /usr/share/bash-completion/completions/awww
install -vDm644 completions/_awww -t /usr/share/zsh/site-functions/
install -vDm644 completions/awww.fish -t /usr/share/fish/vendor_completions.d/</userinput></screen>
-->

    <para>
      Hvis du bygde manualsidene, installer dem som &root; bruker:
    </para>

<!-- intentionally no futureproofing for renaming here because we use a
     wildcard -seal331 5th November 2025 -->
<screen role="root"><userinput>install -vDm644 doc/generated/* -t /usr/share/man/man1/</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <option>--features=avif</option>: Bruk denne bryteren hvis du vil  
      vise AVIF bilder (krever dav1d).
    </para>

  </sect2>

