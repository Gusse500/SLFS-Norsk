<sect1 id="slurp" xreflabel="slurp-&slurp-version;">
  <?dbhtml filename="slurp.html"?>

  <title>slurp-&slurp-version;</title>

  <indexterm zone="slurp">
    <primary sortas="a-slurp">slurp</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til slurp</title>

    <para>
      slurp pakken velger et område på skjermen i et Wayland miljø. Når den 
      brukes med <xref linkend="grim"/>, den kan velge et bestemt 
      område som skal tas i et skjermbilde, som Microsofts 
      utklippsverktøy i Windows.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&slurp-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">slurp Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/x/cairo.html">Cairo</ulink>,
      <ulink url="&blfs-svn;/general/libxkbcommon.html">libxkbcommon</ulink>,
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>, og
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="scdoc"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av slurp</title>

    <para>
      Installer slurp ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

