        </listitem>
      </varlistentry>

      <varlistentry id="s4vol">
        <term><command>s4vol</command></term>
        <listitem>
          <para>
            er et verktøy for avansert manipulering av 3B1 volumbilder
          </para>
          <indexterm zone="s4-3b1-pc7300 s4vol">
