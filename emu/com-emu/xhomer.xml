<sect1 id="xhomer" xreflabel="XHomer-&xhomer-version;">
  <?dbhtml filename="xhomer.html"?>


  <title>XHomer-&xhomer-version;</title>

  <indexterm zone="xhomer">
    <primary sortas="a-xhomer">XHomer</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til XHomer</title>

    <para>
      XHomer pakken inneholder en emulator for DEC Pro 350 datamaskinen, 
      en PDP-11-basert maskin som ble solgt på begynnelsen til 
      midten av 80-tallet.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&xhomer-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="&patch-root;/xhomer/xhomer-&xhomer-version;-close-properly.patch"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="&patch-root;/xhomer/xhomer-&xhomer-version;-fix-util-build.patch"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">XHomer Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/x/installing.html">X vindussystemet</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av XHomer</title>

    <para>
      Bruk en oppdatering for å tillate riktig gjenoppretting av 
      terminalinnstillingene i visse vanlig brukte scenarioer for lukking av 
      XHomer:
    </para>

<screen><userinput>patch -Np1 -i ../xhomer-&xhomer-version;-close-properly.patch</userinput></screen>

    <para>
      Nå, bruk en oppdatering for å fikse kompilering av diverse inkluderte verktøy:
    </para>

<screen><userinput>patch -Np1 -i ../xhomer-&xhomer-version;-fix-util-build.patch</userinput></screen>

    <para>
      Installer XHomer ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make CC="cc -std=gnu17" &amp;&amp;
gcc UTILITIES/lbn2xhomer.c -o UTILITIES/lbn2xhomer &amp;&amp;
gcc UTILITIES/venix2xhomer.c -o UTILITIES/venix2xhomer</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm755 xhomer UTILITIES/{lbn,venix}2xhomer -t /usr/bin/</userinput></screen>

    <para>
      Installer eventuelt dokumentasjonen som &root; bruker:
    </para>

<screen role="root" remap="doc"><userinput>install -vDm644 DOC/* -t /usr/share/doc/xhomer-&xhomer-version;/</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installert Mappe</segtitle>

      <seglistitem>
        <seg>
          xhomer, lbn2xhomer, og venix2xhomer
        </seg>
        <seg>
          Ingen
        </seg>
        <seg>
          /usr/share/doc/xhomer-&xhomer-version;
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="xhomer-bin">
        <term><command>xhomer</command></term>
        <listitem>
          <para>
            er en DEC Pro 350 emulator
          </para>
          <indexterm zone="xhomer xhomer-bin">
            <primary sortas="b-xhomer-bin">xhomer</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="lbn2xhomer">
        <term><command>lbn2xhomer</command></term>
        <listitem>
          <para>
            konverterer RX50 diskavbildningsfiler fra logisk 
            blokkrekkefølge til rå sektorrekkefølge
          </para>
          <indexterm zone="xhomer lbn2xhomer">
            <primary sortas="b-lbn2xhomer">lbn2xhomer</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="venix2xhomer">
        <term><command>venix2xhomer</command></term>
        <listitem>
          <para>
            konverterer RX50 diskavbildningsfiler produsert av Venix til 
            formatet som kreves av <command>xhomer</command>
          </para>
          <indexterm zone="xhomer venix2xhomer">
            <primary sortas="b-venix2xhomer">venix2xhomer</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
