  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til MelonDS</title>

    <para>
      MelonDS pakken tilbyr en NDS emulator.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&melonds-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">melonds Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>,
      <xref linkend="enet"/>,
      &ecm;,
      <ulink url="&blfs-svn;/multimedia/faad2.html">FAAD2</ulink>,
      &unzip;,
      &opengl;,
      <ulink url="&blfs-svn;/x/qt6.html">Qt-6</ulink>,
      &sdl2;, og
      <ulink url="&blfs-svn;/x/x7lib.html">Xorg Libraries</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/x/hicolor-icon-theme.html">hicolor-icon-theme</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av MelonDS</title>

    <para>
      Installer MelonDS ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -G Ninja .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

