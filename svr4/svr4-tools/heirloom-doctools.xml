<sect1 id="heirloom-doctools" xreflabel="heirloom-doctools-&heirloom-doctools-minor-version;">
  <?dbhtml filename="heirloom-doctools.html"?>

  <title>heirloom-doctools-&heirloom-doctools-minor-version;</title>

  <indexterm zone="heirloom-doctools">
    <primary sortas="a-heirloom-doctools">heirloom-doctools</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til heirloom-doctools</title>

    <para>
      heirloom-doctools pakken tilbyr
      troff, nroff, og
      andre relaterte verktøy. Disse verktøyene er forbedrede versjoner av 
      verktøyene utgitt som en del av OpenSolaris, som i seg selv er varianter 
      av ditroff, som i seg selv er etterkommere av den originale UNIX troff.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&heirloom-doctools-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">heirloom-doctools Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="heirloom-ng"/> og
      <xref linkend="heirloom-devtools"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av heirloom-doctools</title>

    <para>
      Installer heirloom-doctools ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure &amp;&amp;
make PREFIX=/usr            \
     CC="cc -std=gnu17"     \
     YACC=/usr/ccs/bin/yacc \
     MANDIR=/usr/share/man/5man</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make PREFIX=/usr MANDIR=/usr/share/man/5man \
install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          addbib, checkeq, checknr, col, dhtml, dpost, eqn, grap, hunt,
          indxbib, inv, lookbib, mkey, neqn, nroff, otf_info, pic, picpack, pm,
          ptx, refer, roffbib, runinv, soelim, sortbib, ta, tbl, troff,
          vfontedpr, og vgrind
        </seg>
        <seg>
          Ingen
        </seg>
        <seg>
          /usr/pub, /usr/ucblib/doctools, og /usr/ucblib/reftools
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="addbib">
        <term><command>addbib</command></term>
