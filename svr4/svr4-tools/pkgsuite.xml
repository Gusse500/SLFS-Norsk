<sect1 id="pkgsuite" xreflabel="pkgsuite-&pkgsuite-minor-version;">
  <?dbhtml filename="pkgsuite.html"?>

  <title>pkgsuite-&pkgsuite-minor-version;</title>

  <indexterm zone="pkgsuite">
    <primary sortas="a-pkgsuite">pkgsuite</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til pkgsuite</title>

    <para>
      pkgsuite pakken er en oppdatert versjon av Heirloom pakkeverktøyene, 
      som i seg selv er en oppdatert, flyttbar versjon av UNIX SVR4 
      pakkeverktøyene.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&pkgsuite-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="&dl-root;/pkgsuite/pkgsuite-&pkgsuite-minor-version;-paths.patch"/>
        </para>
      </listitem>
<!--
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="&dl-root;/pkgsuite/pkgsuite-&pkgsuite-minor-version;-termios.patch"/>
        </para>
      </listitem>
-->
    </itemizedlist>

    <bridgehead renderas="sect3">pkgsuite Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/which.html">Which</ulink>
      <footnote><para>GNU Which er den som må 
      installeres, <emphasis>IKKE</emphasis> skallskriptet, ellers vil det 
      feile i stillhet og gi feil stier til kjørbare filer.
      </para></footnote> og
      <xref linkend="heirloom-ng"/> (ved kjøretid)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av pkgsuite</title>

    <para>
      Installer en oppdatering for å få installasjonsstiene til å samsvare med 
      de andre i denne kategorien:
    </para>

<screen><userinput>patch -Np1 -i ../pkgsuite-&pkgsuite-minor-version;-paths.patch</userinput></screen>

    <para>
      Installer pkgsuite ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>cd src &amp;&amp;
./configure &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

