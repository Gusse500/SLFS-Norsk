<sect1 id="heirloom-ex-vi" xreflabel="heirloom-ex-vi-&heirloom-ex-vi-minor-version;">
  <?dbhtml filename="heirloom-ex-vi.html"?>


  <title>heirloom-ex-vi-&heirloom-ex-vi-minor-version;</title>

  <indexterm zone="heirloom-ex-vi">
    <primary sortas="a-heirloom-ex-vi">heirloom-ex-vi</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til heirloom-ex-vi</title>

    <para>
      Heirloom-ex-vi pakken, også kjent som
      <quote>Den tradisjonelle Vi</quote>, er en flyttbar versjon av 
      2.11BSD/SVR4 vi.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&heirloom-ex-vi-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="&dl-root;/heirloom-ex-vi/heirloom-ex-vi-&heirloom-ex-vi-minor-version;-paths.patch"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">heirloom-ex-vi Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/x/installing.html">X Vindussystemet</ulink>
      (for å bruke wvi)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av heirloom-ex-vi</title>

    <para>
      Installer en oppdatering for å få installasjonsstiene til å samsvare med 
      de andre i denne kategorien:
    </para>

<screen><userinput>patch -Np1 -i ../heirloom-ex-vi-&heirloom-ex-vi-minor-version;-paths.patch</userinput></screen>

    <para>
      Installer heirloom-ex-vi ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure &amp;&amp;
CC="cc -std=gnu17" make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="configuration">
    <title>Konfigurere heirloom-ex-vi</title>

    <sect3 id="heirloom-ex-vi-config">
      <title>Konfigurasjonsfiler</title>
      <para>
        <filename>~/.exrc</filename>
      </para>

      <indexterm zone="heirloom-ex-vi heirloom-ex-vi-config">
        <primary sortas="e-AA.exrc">~/.exrc</primary>
      </indexterm>

    </sect3>

    <sect3><title>Konfigurasjonsinformasjon</title>

      <para>
        Filen ovenfor kan brukes til å konfigurere redigereren. Standardverdiene 
        er greie, men konfigurasjonsfilen ignoreres hvis noen andre enn brukeren 
        som kjører vi har muligheten til å skrive til den. Sørg for at filens 
        oktale tillatelsesverdi er <computeroutput>644</computeroutput> eller 
        lignende i tilfelle du vil bruke den.
      </para>

    </sect3>

  </sect2>

