<sect1 id="i3-wm" xreflabel="i3-&i3-version;">
  <?dbhtml filename="i3-wm.html"?>

  <title>i3-&i3-version;</title>

  <indexterm zone="i3-wm">
    <primary sortas="a-i3-wm">i3</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til i3</title>

    <para>
      i3-pakken inneholder en brukervennlig 
      flisfunksjon for vindusbehandlere.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&i3-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">i3 Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <xref linkend="libev"/>,
      <ulink url="&blfs-svn;/general/libxkbcommon.html">libxkbcommon</ulink>,
      <ulink url="&blfs-svn;/x/pango.html">Pango</ulink>,
      <ulink url="&blfs-svn;/x/startup-notification.html">startup-notification</ulink>,
      <ulink url="&blfs-svn;/x/TTF-and-OTF-fonts.html">TTF og OTF Fonter</ulink>
      (bare TTF fonter er nødvendig),
      <ulink url="&blfs-svn;/x/xcb-utilities.html">XCB Verktøy</ulink>,
      <xref linkend="xcb-util-xrm"/>,
      <ulink url="&blfs-svn;/x/x7lib.html">Xorg Biblioteker</ulink>, og
      <xref linkend="yajl"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/python-modules.html#asciidoc">asciidoc</ulink> og
      <ulink url="&blfs-svn;/pst/xmlto.html">xmlto</ulink> (for generering av
      dokumentasjonen)
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&arch-pkgs;/extra/x86_64/dmenu">dmenu</ulink>
      (for standardstarteren),
      <ulink url="&arch-pkgs;/extra/x86_64/i3lock">i3lock</ulink>
      (for standard skjermlås),
      <ulink url="&arch-pkgs;/extra/x86_64/i3status">i3status</ulink>
      (for standard statuslinjegenerator), og
      <ulink url="&arch-pkgs;/extra/x86_64/xss-lock">xss-lock</ulink>
      (for standard skjermlås)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av i3</title>

    <para>
      Installer i3 ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup ..          \
    --prefix=/usr       \
    --buildtype=release &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install &amp;&amp;
mv -v /usr/share/doc/i3{,-&i3-version;}</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

    <para>
      <command>mv -v /usr/share/doc/i3{,-&i3-version;}</command>: Denne kommandoen 
      gjør at dokumentmappen versjoneres slik at den er konsistent med andre pakker.
    </para>

  </sect2>

  <sect2 role="configuration">
    <title>Konfigurere i3</title>

    <sect3 id="i3-config">
      <title>Konfigurasjonsfiler</title>
      <para>
        <filename>~/.config/i3/config</filename>. Standardversjonen 
        er i <filename class="directory">/etc/i3</filename> og vil 
        ikke bli brukt. Den kan kopieres til
        <filename class="directory">~/.config/i3</filename> manuelt, 
        eller automatisk ved oppstart.
      </para>

      <indexterm zone="i3-wm i3-config">
        <primary sortas="e-AA.config">~/.config/i3/config</primary>
      </indexterm>

    </sect3>

    <sect3><title>Konfigurasjonsinformasjon</title>

      <para>
        Hvis du ikke allerede har laget konfigurasjonsfilen, kan den opprettes 
        når du starter i3 for første gang, når du blir spurt om du vil generere 
        en standard konfigurasjonsfil. Kontroller nå filen og gjør eventuelle 
        endringer hvis du ønsker det. Du må kanskje gjøre det hvis du ikke har 
        installert noen av de valgfrie avhengighetene.
      </para>

      <para>
        Du kan også opprette den ved hjelp av <command>i3-config-wizard</command>, 
        eller du kan ganske enkelt kopiere <filename>/etc/i3/config</filename> 
        til <filename>~/.config/i3/config</filename> (eller
        <filename>~/.i3/config</filename>) og rediger etter behov.
      </para>

      <para>
        Hvis i3 er den eneste vindusbehandleren du vil bruke, kan du starte den 
        med en <filename>.xinitrc</filename> fil i hjemmemappen din. Sørg for å 
        sikkerhetskopiere den nåværende
        <filename>.xinitrc</filename> før du fortsetter.
      </para>

<screen><userinput>echo "exec i3" &gt;&gt; ~/.xinitrc</userinput></screen>

    </sect3>

  </sect2>

  <sect2 role="content">
