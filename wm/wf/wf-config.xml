<sect1 id="wf-config" xreflabel="wf-config-&wf-config-version;">
  <?dbhtml filename="wf-config.html"?>

  <title>wf-config-&wf-config-version;</title>

  <indexterm zone="wf-config">
    <primary sortas="a-wf-config">wf-config</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduction to wf-config</title>

    <para>
      Pakken wf-config tilbyr et bibliotek som administrerer 
      konfigurasjonsfiler for <xref linkend="wayfire"/>.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&wf-config-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">wf-config Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/glm.html">GLM</ulink>,
      <ulink url="&blfs-svn;/x/x7driver.html#libevdev">libevdev</ulink>, og
      <ulink url="&blfs-svn;/general/libxml2.html">libxml2</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="https://github.com/doctest/doctest">doctest</ulink> (for
      tester)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av wf-config</title>

    <para>
      Installer wf-config ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr       \
            --buildtype=release \
            -D tests=disabled   \
            .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

  </sect2>

