  <sect2 role="configuration">
    <title>Konfigurere Hyprland</title>

    <sect3 id="hyprland-config">
      <title>Konfigurasjonsfiler</title>
      <para>
        <filename>~/.config/hypr/hyprland.conf</filename>. Standardversjonen er 
        i <filename class="directory">/usr/share/hypr</filename> og vil ikke 
        bli brukt og må kopieres til
        <filename class="directory">~/.config/hypr</filename>
      </para>

      <indexterm zone="hyprland hyprland-config">
        <primary sortas="e-AA.config">~/.config/hypr/hyprland.conf</primary>
      </indexterm>

    </sect3>

    <sect3><title>Konfigurasjonsinformasjon</title>

      <para>
        Opprett konfigurasjonsfilen:
      </para>

<screen><userinput>mkdir -pv ~/.config/hypr &amp;&amp;
cp /usr/share/hypr/hyprland.conf ~/.config/hypr</userinput></screen>

      <para>
        Inspiser nå filen og gjør eventuelle endringer som passer til arbeidsflyten din.
      </para>

    </sect3>

  </sect2>

