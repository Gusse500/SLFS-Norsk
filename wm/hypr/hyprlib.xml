<sect1 id="hyprlib" xreflabel="Hyprland Biblioteker">
  <?dbhtml filename="hyprlib.html"?>

  <title>Hyprland Biblioteker</title>

  <indexterm zone="hyprlib">
    <primary sortas="a-hyprlib">Hyprland Biblioteker</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Hyprland Biblioteker</title>

    <para>
      Hyprland bibliotekene tilbyr nødvendige verktøy for hele Hyprland 
      økosystemet. Selv om tre av pakkene som er installert på denne siden ikke 
      er strengt nødvendige (hyprtoolkit, hyprland-qt-support og 
      hyprland-guiutils), er de nødvendige for noen dialogbokser, og denne boken 
      forutsetter at du har bygget dem.
    </para>

    &abi-break;

    &long-build-time;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&hyprlib-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Hyprland Biblioteker Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/x/cairo.html">Cairo</ulink>,
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>,
      &gbm;,
      <ulink url="&blfs-svn;/x/glslang.html">Glslang</ulink>,
      <ulink url="&blfs-svn;/general/libdisplay-info.html">libdisplay-info</ulink>,
      <ulink url="&blfs-svn;/x/libdrm.html">libdrm</ulink>,
      <ulink url="&blfs-svn;/x/x7driver.html#libinput">libinput</ulink>,
      <ulink url="&blfs-svn;/general/libjxl.html">libjxl</ulink>,
      <ulink url="&blfs-svn;/general/libpng.html">libpng</ulink>,
      <ulink url="&blfs-svn;/general/librsvg.html">librsvg</ulink>,
      <ulink url="&blfs-svn;/general/libwebp.html">libwebp</ulink>,
      <xref linkend="libzip"/>,
      &wayland-gl;,
      <ulink url="&blfs-svn;/general/pixman.html">Pixman</ulink>,
      <xref linkend="pugixml"/>,
      <ulink url="&blfs-svn;/x/qt6.html">Qt-6</ulink>,
      <xref linkend="seatd"/>,
      <xref linkend="tomlplusplus"/>,
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>, og
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/postlfs/profile.html">Oppstartsfilene til Bash 
