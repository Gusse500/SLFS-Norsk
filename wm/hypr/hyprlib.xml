    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          hyprcursor-util,
          hyprland-dialog,
          hyprland-donate-screen,
          hyprland-update-screen,
          hyprland-welcome,
          hyprland-run,
          hyprwayland-scanner, og
          hyprwire-scanner
        </seg>
        <seg>
          libaquamarine,
          libhyprcursor,
          libhyprgraphics,
          libhyprland-quick-style-implplugin,
          libhyprland-quick-style-impl,
          libhyprland-quick-styleplugin,
          libhyprland-quick-style,
          libhyprlang,
          libhyprtoolkit,
          libhyprutils, og
          libhyprwire
        </seg>
        <seg>
          /usr/include/{aquamarine,hypr{cursor,graphics,toolkit,utils,wire}},
          /usr/lib/cmake/hypr{wayland,wire}-scanner,
          /usr/lib/qt6/qml/org/hyprland/style, og
          /usr/share/hyprland-protocols
        </seg>
      </seglistitem>
    </segmentedlist>

