    </para>

  </sect2>

  <sect2>
    <title>Laste ned Hyprland Biblioteker</title>

    <para>
      Lag først en liste over filer som skal lastes ned:
    </para>

<screen><userinput>cat &gt; hypr-list &lt;&lt; "EOF"
<literal>hyprland-protocols/archive/v&hyprland-protocols-version;/hyprland-protocols-&hyprland-protocols-version;.tar.gz
hyprutils/archive/v&hyprutils-version;/hyprutils-&hyprutils-version;.tar.gz
hyprlang/archive/v&hyprlang-version;/hyprlang-&hyprlang-version;.tar.gz
hyprwire/archive/v&hyprwire-version;/hyprwire-&hyprwire-version;.tar.gz
hyprcursor/archive/v&hyprcursor-version;/hyprcursor-&hyprcursor-version;.tar.gz
hyprwayland-scanner/archive/v&hyprwayland-scanner-version;/hyprwayland-scanner-&hyprwayland-scanner-version;.tar.gz
aquamarine/archive/v&aquamarine-version;/aquamarine-&aquamarine-version;.tar.gz
hyprgraphics/archive/v&hyprgraphics-version;/hyprgraphics-&hyprgraphics-version;.tar.gz
hyprtoolkit/archive/v&hyprtoolkit-version;/hyprtoolkit-&hyprtoolkit-version;.tar.gz
hyprland-qt-support/archive/v&hyprland-qt-support-version;/hyprland-qt-support-&hyprland-qt-support-version;.tar.gz
hyprland-guiutils/archive/v&hyprland-guiutils-version;/hyprland-guiutils-&hyprland-guiutils-version;.tar.gz</literal>
EOF</userinput></screen>

    <para>
      For å laste ned de nødvendige filene ved hjelp av
      <ulink url="&blfs-svn;/basicnet/wget.html">Wget</ulink>,
      bruk følgende kommandoer:
    </para>

<screen><userinput>mkdir hyprlib &amp;&amp;
cd    hyprlib &amp;&amp;
grep -v '^#' ../hypr-list | wget -i- -c \
    -B &hyprlib-download;</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Hyprland Biblioteker</title>

    <para>
      Opprett <filename>/etc/profile.d/hypr.sh</filename> for å sikre at QML 
      filer kan lastes inn og importeres som &root; bruker:
    </para>

<screen role="root"><userinput>cat &gt; /etc/profile.d/hypr.sh &lt;&lt; "EOF"
<literal># Begin /etc/profile.d/hypr.sh

pathappend /usr/lib/plugins        QT_PLUGIN_PATH
pathappend $QT6DIR/lib/plugins     QT_PLUGIN_PATH

pathappend /usr/lib/qt6/qml        QML2_IMPORT_PATH
pathappend $QT6DIR/lib/qml         QML2_IMPORT_PATH

# End /etc/profile.d/hypr.sh
EOF</literal></userinput></screen>

    &source-profile;

    &as_root;

    <para>
      Deretter starter du et underskall som avsluttes ved feil:
    </para>

<screen><userinput>bash -e</userinput></screen>

    <para>
      Installer alle pakkene ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>for package in $(grep -v '^#' ../hypr-list)
do
package=$(basename "$package")
packagedir=${package%.tar.?z*}
echo "Building $packagedir"

  tar -xf $package
  pushd $packagedir

  case $packagedir in
    hyprland-protocols-[0-9]* )
      mkdir build
      cd build
        meson setup --prefix=/usr ..
    ;;<!--

    aquamarine-[0-9]* )

      <literal># If Mesa libGL is installed, force CMake to use it</literal>
      if ! pkgconf libglvnd; then
        sed -i 's/OpenGL::OpenGL/OpenGL::GL/g'   \
          CMakeLists.txt
      fi

      mkdir build
      cd    build
        cmake -D CMAKE_INSTALL_PREFIX=/usr       \
              -D CMAKE_BUILD_TYPE=Release        \
              -D CMAKE_SKIP_INSTALL_RPATH=ON     \
              -G Ninja ..
    ;;-->

    * )
      mkdir build
      cd    build
        cmake -D CMAKE_INSTALL_PREFIX=/usr       \
              -D CMAKE_BUILD_TYPE=Release        \
              -D CMAKE_SKIP_INSTALL_RPATH=ON     \
              -D INSTALL_QML_PREFIX=/lib/qt6/qml \
              -D DISABLE_TESTS=ON                \
              -D BUILD_TESTING=OFF               \
              -W no-dev -G Ninja ..
    ;;
  esac

  ninja
  as_root ninja install
  popd
  rm -rf $packagedir
  as_root /sbin/ldconfig
done</userinput></screen>

    <para>
      Til slutt, avslutt skallet som ble startet tidligere:
    </para>

<screen><userinput>exit</userinput></screen>

  </sect2>

