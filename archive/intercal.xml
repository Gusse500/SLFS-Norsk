<sect1 id="cintercal" xreflabel="cintercal-&intercal-version;">
  <?dbhtml filename="intercal.html"?>

  <title>C-INTERCAL-&intercal-version;</title>

  <indexterm zone="cintercal">
    <primary sortas="a-cintercal">c-intercal</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til C-INTERCAL</title>

    <para>
      C-INTERCAL pakken inneholder en kompilator for Compiler Language With No 
      Pronounceable Acronym (INTERCAL).
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&cintercal-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av C-INTERCAL</title>

    <para>
      Installer C-INTERCAL ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>autoreconf -fiv &amp;&amp;
./configure --prefix=/usr &amp;&amp;
make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          convickt og ick
        </seg>
        <seg>
          libick, libickec, libickmt, og libyuk (alle statiske)
        </seg>
        <seg>
          /usr/include/ick-&intercal-version; og
          /usr/share/ick-&intercal-version;
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="convickt">
        <term><command>convickt</command></term>
        <listitem>
          <para>
            konverterer INTERCAL filer mellom formater
          </para>
          <indexterm zone="cintercal convickt">
            <primary sortas="b-convickt">convickt</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="ick">
        <term><command>ick</command></term>
        <listitem>
          <para>
            er INTERCAL kompilatoren
          </para>
          <indexterm zone="cintercal ick">
            <primary sortas="b-ick">ick</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libick">
        <term><filename class="libraryfile">libick</filename></term>
        <listitem>
          <para>
            inneholder kjøretidsfunksjonene for INTERCAL kompilatoren
          </para>
          <indexterm zone="cintercal libick">
            <primary sortas="c-libick">libick</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libickec">
        <term><filename class="libraryfile">libickec</filename></term>
        <listitem>
          <para>
            inneholder kjøretidsfunksjonene for INTERCAL programmer
          </para>
          <indexterm zone="cintercal libickec">
            <primary sortas="c-libickec">libickec</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libickmt">
        <term><filename class="libraryfile">libickmt</filename></term>
        <listitem>
          <para>
            er den flertrådete versjonen av libick
          </para>
          <indexterm zone="cintercal libickmt">
            <primary sortas="c-libickmt">libickmt</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libyuk">
        <term><filename class="libraryfile">libyuk</filename></term>
        <listitem>
          <para>
            inneholder støttefunksjoner for yuk, INTERCAL feilsøkingsprogrammet
          </para>
          <indexterm zone="cintercal libyuk">
            <primary sortas="c-libyuk">libyuk</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
