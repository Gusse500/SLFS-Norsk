  <sect2 role="package">
    <title>Introduksjon til wev</title>

    <para>
      Wev pakken inneholder et verktøy for å vise Wayland hendelser.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&wev-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">wev Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/libxkbcommon.html">libxkbcommon</ulink>,
      <xref linkend="scdoc"/>,
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>, og
      <ulink url="&blfs-svn;/general/wayland-protocols.html">Wayland-Protocols</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av wev</title>

    <para>
      Installer wev ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make PREFIX=/usr install</userinput></screen>

  </sect2>

