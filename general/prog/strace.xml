<sect1 id="strace" xreflabel="strace-&strace-version;">
  <?dbhtml filename="strace.html"?>


  <title>strace-&strace-version;</title>

  <indexterm zone="strace">
    <primary sortas="a-strace">strace</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til strace</title>

    <para>
      Strace pakken tilbyr et verktøy for diagnostikk, feilsøking og instruksjonsbruk i brukerområdet.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&strace-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">strace Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/general/libunwind.html">libunwind</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av strace</title>

    <para>
      Installer strace ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr \
    --enable-mpers=no &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>
  
  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <parameter>--enable-mpers=no</parameter>: Som standard er strace bygget for å støtte både m32 og mx32. Denne parameteren deaktiverer denne oppførselen.
    </para>

    <para>
      <parameter>--with-libunwind</parameter>: Denne parameteren bygger strace med støtte for libunwind.
    </para>

    <note><para>
      Kjør <userinput>./configure --help</userinput> for en fullstendig liste over alternativer.
    </para></note>

  </sect2>

