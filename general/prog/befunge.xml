<sect1 id="befunge93" xreflabel="befunge93-&befunge-version;">
  <?dbhtml filename="befunge.html"?>

  <title>Befunge-93-&befunge-version;</title>

  <indexterm zone="befunge93">
    <primary sortas="a-befunge93">Befunge-93</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til befunge</title>

    <para>
      Befunge-93 pakken inneholder referanseimplementeringen 
      av Befunge språket.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&befunge93-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Befunge-93</title>

    <note><para>Denne pakken pakker ut til befunge-93.</para></note>

    <para>
      Installer Befunge-93 ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>install -v -Dm755 bin/bef /usr/bin &amp;&amp;
install -v -Dm755 bin/befprof /usr/bin &amp;&amp;
install -v -Dm755 bin/bef2c /usr/bin</userinput></screen>

  </sect2>

