  <sect2 id="platformdirs" xreflabel="platformdirs-&platformdirs-version;">

    <title>platformdirs-&platformdirs-version;</title>

    <indexterm zone="platformdirs">
      <primary sortas="a-platformdirs">platformdirs</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduksjon til platformdirs modulen</title>

      <para>
        Platformdirs modulen tilbyr standard 
        mappestier på forskjellige plattformer, 
        slik at data lagres i riktig sti.
      </para>

      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Nedlasting: <ulink url="&platformdirs-download;"/>
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">platformdirs Avhengigheter</bridgehead>

      <bridgehead renderas="sect5">Påkrevd</bridgehead>
      <para role='required'>
        <ulink url='&pydep;hatch-vcs'>hatch_vcs</ulink>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Installasjon av platformdirs</title>

      <para>Bygg modulen:</para>

      &build-wheel;

      <para>
        Nå, som &root; bruker:
      </para>

<screen role="root"><userinput>&install-wheel; platformdirs</userinput></screen>

    </sect3>

    &pip3-cmd-explain;

