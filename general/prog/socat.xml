<sect1 id="socat" xreflabel="socat-&socat-version;">
  <?dbhtml filename="socat.html"?>


  <title>socat-&socat-version;</title>

  <indexterm zone="socat">
    <primary sortas="a-socat">socat</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til socat</title>

    <para>
      Socat pakken tilbyr et flerbruks reléverktøy.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&socat-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">socat Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="https://packages.debian.org/sid/libwrap0">tcp-wrappers</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av socat</title>

    <para>
      Installer socat ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr \
    --mandir=/usr/share/man &amp;&amp;
make</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>make test</command>.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          filan,
          procan,
          socat (lenke til socat1),
          socat-broker.sh,
          socat-chain.sh,
          socat-mux.sh, og
          socat1
        </seg>
      </seglistitem>
      <seglistitem>
        <seg>
          Ingen
        </seg>
      </seglistitem>
      <seglistitem>
        <seg>
          Ingen
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="filan">
        <term><command>filan</command></term>
        <listitem>
         <para>
           er et hjelpeverktøy for filanalyse
         </para>
          <indexterm zone="socat filan">
            <primary sortas="b-filan">filan</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="procan">
        <term><command>procan</command></term>
        <listitem>
         <para>
           er et hjelpeverktøy for prosessanalyse
         </para>
          <indexterm zone="socat procan">
            <primary sortas="b-procan">procan</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="socat-bin">
        <term><command>socat</command></term>
        <listitem>
         <para>
           er flerbruksreléet
         </para>
          <indexterm zone="socat socat-bin">
            <primary sortas="b-socat">socat</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="socat-broker.sh">
        <term><command>socat-broker.sh</command></term>
        <listitem>
         <para>
           er et skallskript for å utføre gruppekommunikasjon (aka brokering)
         </para>
          <indexterm zone="socat socat-broker.sh">
            <primary sortas="b-socat-broker.sh">socat-broker.sh</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="socat-chain.sh">
        <term><command>socat-chain.sh</command></term>
        <listitem>
         <para>
           er et (beta) skallskript for å bygge en kjede av socat instanser
         </para>
          <indexterm zone="socat socat-chain.sh">
            <primary sortas="b-socat-chain.sh">socat-chain.sh</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="socat-mux.sh">
        <term><command>socat-mux.sh</command></term>
        <listitem>
         <para>
           er et skallskript for å etablere mange-til-en-, én-til-alle kommunikasjon
         </para>
          <indexterm zone="socat socat-mux.sh">
            <primary sortas="b-socat-mux.sh">socat-mux.sh</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

