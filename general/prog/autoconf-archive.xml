  <sect2 role="package">
    <title>Introduksjon til Autoconf Arkiv</title>

    <para>
      Autoconf Arkiv inneholder mer enn 500 autoconf makroer som er bidratt 
      til GNU.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&autoconf-archive-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av autoconf-archive</title>

    <para>
      Installer autoconf-archive ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr \
--docdir=/usr/share/doc/autoconf-archive-&autoconf-archive-version; &amp;&amp;
make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

