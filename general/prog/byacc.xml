  <sect2 role="package">
    <title>Introduksjon til byacc</title>

    <para>
      byacc pakken inneholder en implementering av <command>yacc</command>
      som stammer fra BSD.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&byacc-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av byacc</title>

    <para>
      Installer byacc ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr      \
            --program-prefix=b \
            --with-manpage-format=formatted &amp;&amp;
make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

