<sect1 id="scdoc" xreflabel="scdoc-&scdoc-version;">
  <?dbhtml filename="scdoc.html"?>

  <title>scdoc-&scdoc-version;</title>

  <indexterm zone="scdoc">
    <primary sortas="a-scdoc">scdoc</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til scdoc</title>

    <para>
      scdoc pakken tilbyr en manualside 
      generator.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&scdoc-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av scdoc</title>

    <para>
      Installer scdoc ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make PREFIX=/usr LDFLAGS="$LDFLAGS"</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make PREFIX=/usr install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <envar>LDFLAGS="$LDFLAGS"</envar>: Dette sikrer at hvis
      <envar>$LDFLAGS</envar> er satt, at byggesystemet respekterer det. 
      Ellers vil det fjerne variabelen for byggeprosessen.
    </para>

  </sect2>

