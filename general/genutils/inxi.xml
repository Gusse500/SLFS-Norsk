<sect1 id="inxi" xreflabel="inxi-&inxi-version;">
  <?dbhtml filename="inxi.html"?>

  <title>inxi-&inxi-version;</title>

  <indexterm zone="inxi">
    <primary sortas="a-inxi">inxi</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til inxi</title>

    <para>
      Inxi pakken tilbyr et kommandolinjeprogram som henter informasjon om 
      systemet du ber om via et Perl skript.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&inxi-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    &dl-rename;
<screen
  role="nodump"><userinput>mv -v &inxi-version;.tar.gz inxi-&inxi-version;.tar.gz</userinput></screen>

    <bridgehead renderas="sect3">inxi Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/pciutils.html">pciutils</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/basic-net/bind-utils.html">Bind Utilities</ulink>,
      <ulink url="&blfs-svn;/general/bluez.html">BlueZ</ulink>,
      <ulink url="&blfs-svn;/basicnet/curl.html">cURL</ulink>,
      <ulink url="&blfs-svn;/general/lm-sensors.html">lm-sensors</ulink>,
      <ulink url="&blfs-svn;/postlfs/lvm2.html">LVM2</ulink>,
      <ulink url="&blfs-svn;/general/perl-modules.html#perl-io-socket-ssl">IO-Socket-SSL</ulink>,
      <ulink url="&blfs-svn;/postlfs/smartmontools.html">smartmontools</ulink>,
      <ulink url="&blfs-svn;/postlfs/sudo.html">Sudo</ulink>,
      <ulink url="&blfs-svn;/general/tree.html">tree</ulink>,
      <ulink url="&blfs-svn;/general/upower.html">UPower</ulink>,
      <ulink url="&blfs-svn;/general/usbutils.html">usbutils</ulink>,
      <ulink url="&blfs-svn;/basicnet/wget.html">wget</ulink>, og
      <ulink url="&blfs-svn;/x/x7app.html">Xorg Applications</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="mesa-demos"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av inxi</title>

    <note><para>
      Denne pakken utvides til mappen <filename
      class="directory">inxi</filename>.
    </para></note>

    <para>
      Som &root; bruker, installer pakken:
    </para>

<screen role="root"><userinput>install -vDm755 inxi -t /usr/bin/</userinput></screen>

    <para>
      Installer dokumentasjonen som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm644 inxi.1 -t /usr/share/man/man1/</userinput></screen>

  </sect2>

