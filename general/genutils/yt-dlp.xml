<sect1 id="yt-dlp" xreflabel="yt-dlp-&yt-dlp-version;">
  <?dbhtml filename="yt-dlp.html"?>

  <title>yt-dlp-&yt-dlp-version;</title>

  <indexterm zone="yt-dlp">
    <primary sortas="a-yt-dlp">yt-dlp</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til yt-dlp</title>

    <para>
      yt-dlp-pakken tilbyr et funksjonsrikt kommandolinjeprogram for nedlasting 
      av lyd/video, som støtter tusenvis av nettsteder, inkludert YouTube. Den 
      kan konvertere nedlastinger til andre formater ved hjelp av FFmpeg..
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&yt-dlp-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">yt-dlp Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/zip.html">Zip</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/basicnet/curl.html">cURL</ulink>,
      <ulink url="&blfs-svn;/multimedia/ffmpeg.html">FFmpeg</ulink>, og
      <ulink url="&blfs-svn;/postlfs/make-ca.html">make-ca</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/general/python-modules.html#requests">requests</ulink> og
      <ulink url="&blfs-svn;/general/brotli.html">brotli</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av yt-dlp</title>

    <para>
      Installer yt-dlp ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>make yt-dlp</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm755 yt-dlp -t /usr/bin/</userinput></screen>

  </sect2>

