<sect1 id="ncompress" xreflabel="ncompress-&ncompress-version;">
  <?dbhtml filename="ncompress.html"?>

  <title>ncompress-&ncompress-version;</title>

  <indexterm zone="ncompress">
    <primary sortas="a-ncompress">ncompress</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til ncompress</title>

    <para>
      Pakken ncompress tilbyr en SVR4 kompatibel implementering av <command>compress</command>.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&ncompress-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>
   
  </sect2>

  <sect2 role="installation">
    <title>Installasjon av ncompress</title>

    <para>
      Installer ncompress ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>CFLAGS+=" -std=gnu17" make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make PREFIX=/usr install_core</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          compress og uncompress
        </seg>
        <seg>
          Ingen
        </seg>
        <seg>
          Ingen
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="compress">
        <term><command>compress</command></term>
        <listitem>
          <para>
            komprimerer filer ved hjelp av LZ koding
          </para>
          <indexterm zone="ncompress compress">
            <primary sortas="b-compress">compress</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="uncompress">
        <term><command>uncompress</command></term>
        <listitem>
          <para>
            pakker ut filer ved hjelp av LZ koding
          </para>
          <indexterm zone="ncompress uncompress">
            <primary sortas="b-uncompress">uncompress</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>  

