  <sect2 role="package">
    <title>Introduksjon til ncdu</title>

    <para>
      ncdu pakken tilbyr en lett ncurses basert diskplassanalysator.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&ncdu-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av ncdu</title>

    <para>
      Installer ncdu ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr &amp;&amp;
make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

