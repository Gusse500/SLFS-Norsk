<sect1 id="minicom" xreflabel="minicom-&minicom-version;">
  <?dbhtml filename="minicom.html"?>


  <title>minicom-&minicom-version;</title>

  <indexterm zone="minicom">
    <primary sortas="a-minicom">minicom</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til minicom</title>

    <para>
      Minicom pakken tilbyr et seriellt 
      kommunikasjonsprogram.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&minicom-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">minicom Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="lrzsz"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="https://github.com/KermitProject/ckermit">C-Kermit</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av minicom</title>

    <para>
      Installer minicom ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          ascii-xfr, minicom, runscript, og xminicom
        </seg>
        <seg>
          Ingen
        </seg>
        <seg>
          Ingen
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="ascii-xfr">
        <term><command>ascii-xfr</command></term>
        <listitem>
          <para>
            overfører filer ved hjelp av ASCII tegnsettet
          </para>
          <indexterm zone="minicom ascii-xfr">
            <primary sortas="b-ascii-xfr">ascii-xfr</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="minicom-bin">
        <term><command>minicom</command></term>
        <listitem>
          <para>
            er det serielle kommunikasjonsprogrammet
          </para>
          <indexterm zone="minicom minicom-bin">
            <primary sortas="b-minicom-bin">minicom</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="runscript">
        <term><command>runscript</command></term>
        <listitem>
          <para>
            er en skripttolk for <command>minicom</command>
          </para>
          <indexterm zone="minicom runscript">
            <primary sortas="b-runscript">runscript</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="xminicom">
        <term><command>xminicom</command></term>
        <listitem>
          <para>
            er en skriptinnpakning rundt <command>minicom</command>
            som kjører <command>minicom</command> med fargestøtte hvis en 
            kompatibel X11 terminalemulator er tilgjengelig
          </para>
          <indexterm zone="minicom xminicom">
            <primary sortas="b-xminicom">xminicom</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

