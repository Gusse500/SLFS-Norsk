  <sect2 role="package">
    <title>Introduksjon til htop</title>

    <para>
      htop pakken tilbyr en TUI
      <footnote><para>
        Tekstbasert brukergrensesnitt.
      </para></footnote>
      systemmonitor og har blitt kjent for sin brukervennlighet og 
      omfattende funksjoner.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&htop-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">htop Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/general/lm-sensors.html">lm-sensors</ulink>,
      <ulink url="&blfs-svn;/general/lsof.html">lsof</ulink>, og
      <xref linkend="strace"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av htop</title>

    <para>
      Installer htop ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

