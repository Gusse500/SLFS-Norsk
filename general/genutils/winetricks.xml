<sect1 id="winetricks" xreflabel="Winetricks-&winetricks-version;">
  <?dbhtml filename="winetricks.html"?>

  <title>Winetricks-&winetricks-version;</title>

  <indexterm zone="winetricks">
    <primary sortas="a-winetricks">Winetricks</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Winetricks</title>

    <para>
      Winetricks er et skallskript som kan fikse diverse problemer med <ulink
      url="&glfs-website;/wine/wine.html">Wine</ulink>. Oftest oppstår disse 
      problemene på grunn av manglende filer som noen applikasjoner forventer, 
      for eksempel skriftfiler. Denne pakken kan laste ned disse filene og 
      pakke dem ut om nødvendig.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&winetricks-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Winetricks Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/basicnet/curl.html">cURL</ulink> eller
      <ulink url="&blfs-svn;/basicnet/wget.html">Wget</ulink> og
      <ulink url="&glfs-website;/wine/wine.html">Wine</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/7zip.html">7zip</ulink>,
      &unzip;,
      <xref linkend="libmspack"/>,
      <ulink url="&blfs-svn;/general/unrar.html">UnRar</ulink>, og
      <ulink url="&blfs-svn;/xsoft/xdg-utils.html">xdg-utils</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&arch-pkgs;/extra/x86_64/kdialog">kdialog</ulink> (for KDE)
      eller
      <ulink url="&arch-pkgs;/extra/x86_64/zenity">zentiy</ulink> (for GNOME);
      Denne pakken bruker en av dem for å tilby et grafisk grensesnitt, men er valgfritt
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Winetricks</title>

    <para>
      Installer Winetricks som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>
  
