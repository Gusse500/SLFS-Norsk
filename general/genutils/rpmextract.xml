<sect1 id="rpmextract" xreflabel="rpmextract-&rpmextract-version;">
  <?dbhtml filename="rpmextract.html"?>

  <title>rpmextract-&rpmextract-version;</title>

  <indexterm zone="rpmextract">
    <primary sortas="a-rpmextract">rpmextract</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til rpmextract</title>

    <para>
      rpmextract pakken tilbyr verktøy for 
      utpakking av <filename class="extension">.rpm</filename> filer.
    </para>

    <bridgehead renderas="sect3">rpmextract Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/libarchive.html">libarchive</ulink>
    </para>

  </sect2>

  <sect2>
    <title>Laste ned rpmextract</title>

    <para>
      For å laste ned rpmextract filene med <ulink
      url="&blfs-svn;/basicnet/wget.html">wget</ulink>, kjør følgende 
      instruksjoner:
    </para>

<screen><userinput>mkdir rmpextract-&rpmextract-version; &amp;&amp;
cd    rmpextract-&rpmextract-version; &amp;&amp;
for i in {rpm2cpio,rpmextract.sh}; do
  echo $i | wget -i- -c \
    -B &rpmextract-common-dl;/
done</userinput></screen>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av rpmextract</title>

    <para>
      Installer rpmextract ved å kjøre følgende 
      kommandoer som &root; bruker:
    </para>

<screen role="root"><userinput>install -vm755 rpm2cpio rpmextract.sh /usr/bin &amp;&amp;
ln -sfv rpmextract.sh /usr/bin/rpmextract</userinput></screen>

  </sect2>

