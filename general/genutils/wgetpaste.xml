<sect1 id="wgetpaste" xreflabel="wgetpaste-&wgetpaste-version;">
  <?dbhtml filename="wgetpaste.html"?>

  <title>wgetpaste-&wgetpaste-version;</title>

  <indexterm zone="wgetpaste">
    <primary sortas="a-wgetpaste">wgetpaste</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til wgetpaste</title>

    <para>
      wgetpaste pakken inneholder et skript som laster opp tekstfiler til 
      pastebin tjenester.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&wgetpaste-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>
  </sect2>

  <sect2 role="installation">
    <title>Installasjon av wgetpaste</title>

    <para>
      wgetpaste pakken trenger ikke å bli kompilert 
      og kan installeres direkte ved å kjøre følgende 
      kommando som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm755 wgetpaste -t /usr/bin/</userinput></screen>

    <para>
      Hvis du vil installere skallfullføringsfilen for zsh, 
      utfør følgende som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm644 _wgetpaste -t /usr/share/zsh/site-functions/</userinput></screen>

  </sect2>

