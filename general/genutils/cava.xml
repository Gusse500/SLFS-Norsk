<sect1 id="cava" xreflabel="cava-&cava-version;">
  <?dbhtml filename="cava.html"?>

  <title>cava-&cava-version;</title>

  <indexterm zone="cava">
    <primary sortas="a-cava">cava</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til cava</title>

    <para>
      cava pakken tilbyr en lydvisualiseringsprogramvare.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&cava-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">cava Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/fftw.html">fftw</ulink> og
      <xref linkend="iniparser"/>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/multimedia/alsa-lib.html">alsa-lib</ulink>,
      &opengl;,
      <ulink url="&blfs-svn;/multimedia/pipewire.html">Pipewire</ulink>,
      <ulink url="&blfs-svn;/multimedia/pulseaudio.html">PulseAudio</ulink>,
      og &sdl2;
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&arch-pkgs;/extra/x86_64/jack2/">JACK2</ulink>,
      <ulink url="&arch-pkgs;/extra/x86_64/portaudio/">PortAudio</ulink>, og
      <ulink url="&arch-pkgs;/extra/x86_64/sndio/">sndio</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av cava</title>

    <para>
      Installer cava ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

