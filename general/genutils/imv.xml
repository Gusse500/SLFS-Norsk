  <sect2 role="package">
    <title>Introduksjon til imv</title>

    <para>
      imv pakken tilbyr en bildevisningsprogramvare.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&imv-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Additional Downloads</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Valgfri oppdatering:
          <ulink url="https://raw.githubusercontent.com/alpinelinux/aports/refs/heads/master/community/imv/move-wayland-and-x11-to-libexec.patch"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">imv Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      Grafisk miljø (<ulink
      url="&blfs-svn;/x/xorg-server.html">Xorg-Server</ulink> eller
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>),
      <ulink url="&blfs-svn;/general/icu.html">ICU</ulink>,
      <ulink url="&blfs-svn;/general/libxkbcommon.html">libxkbcommon</ulink>, og
      <ulink url="&blfs-svn;/x/pango.html">Pango</ulink> (med Cairo)
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&glfs-website;/shareddeps/glu.html">GLU</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&pymod;asciidoc">asciidoc</ulink>,
      <ulink url="&blfs-svn;/general/libheif.html">libheif</ulink>,
      <ulink url="&blfs-svn;/general/libjpeg.html">libjpeg-turbo</ulink>,
      <ulink url="&blfs-svn;/general/libjxl.html">libjxl</ulink>,
      <ulink url="&blfs-svn;/general/libpng.html">libpng</ulink>,
      <ulink url="&blfs-svn;/general/librsvg.html">librsvg</ulink>,
      <ulink url="&blfs-svn;/general/libtiff.html">libtiff</ulink>,
      <ulink url="&blfs-svn;/general/libwebp.html">libwebp</ulink>,
      <ulink url="&arch-pkgs;/extra/x86_64/libnsbmp/">libnsbmp</ulink>,
      <ulink url="&arch-pkgs;/extra/x86_64/libnsgif/">libnsgif</ulink>, og
      <ulink url="&arch-pkgs;/extra/any/qoi/">qoi</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av imv</title>

    <para>
      Alternativt kan du bruke en oppdatering for å flytte Wayland og X11 
      bakstykkene til libexec mappen:
    </para>

<screen><userinput>patch -Np1 -i ../move-wayland-and-x11-to-libexec.patch</userinput></screen>

    <para>
      Tving IMV til å lenke til det vanlige ICU biblioteket:
    </para>

<!-- https://raw.githubusercontent.com/alpinelinux/aports/7a73ae2bf717a71642a4455a777c6cc996c24c22/community/imv/imv-4.5.0-Link-to-the-common-ICU-library.patch -->
<screen><userinput>sed -i 's/icu-io/icu-uc/g' meson.build</userinput></screen>

    <para>
      Installer imv ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup ..              \
      --prefix=/usr         \
      --buildtype=release   \
      -D windows=all        \
      -D unicode=icu        \
      -D test=disabled      \
      -D contrib-commands=false &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

    <para>
      <parameter>-D windows=all</parameter>: Denne parameteren bygger støtte for 
      Wayland og X11, og bestemmer hvilken som skal brukes under kjøring.
    </para>

    <para>
      <parameter>-D unicode=icu</parameter>: Denne parameteren angir ICU som 
      Unicode bakstykke.
    </para>

    <para>
      <parameter>-D tests=disabled</parameter>: Denne parameteren deaktiverer tester.
    </para>

    <para>
      <parameter>-D contrib-commands=false</parameter>: Denne parameteren 
      forhindrer installasjon av medleverte kommandoer. Hvis du ønsker å 
      installere dem, fjern denne parameteren.
    </para>

  </sect2>

