<sect1 id="ostree" xreflabel="OSTree-&ostree-version;">
  <?dbhtml filename="ostree.html"?>


  <title>OSTree-&ostree-version;</title>

  <indexterm zone="ostree">
    <primary sortas="a-ostree">OSTree</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til OSTree</title>

    <para>
      OSTreepakken er for containerdistribusjon og lignende. 
      Den er påkrevd av <xref linkend="flatpak"/>.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&ostree-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">OSTree Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/postlfs/fuse.html">Fuse3</ulink> og
      <ulink url="&blfs-svn;/general/glib2.html">GLib</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/basicnet/curl.html">cURL</ulink> og
      <ulink url="&blfs-svn;/postlfs/gpgme.html">gpgme</ulink>
      (påkrevd for Flatpak),
      <ulink url="&blfs-svn;/general/gtk-doc.html">GTK-Doc</ulink>,
      <ulink url="&blfs-svn;/general/libxslt.html">libxslt</ulink>, og
      &logind-nocomma;
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="fuse2"/>,
      <ulink url="https://linuxfromscratch.org/blfs/view/12.3/basicnet/libsoup.html">libsoup</ulink>,
      og <ulink url="&blfs-svn;/basicnet/libsoup3.html">libsoup3</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av OSTree</title>

    <para>
      Installer OSTree ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr     \
            --sysconfdir=/etc \
            --disable-static  \
            --with-curl       \
            --with-soup=no   &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          ostree, ostree-prepare-root, ostree-remount, og rofiles-fuse
        </seg>
        <seg>
          libostree-1
        </seg>
        <seg>
          /etc/ostree/remotes.d, /usr/include/ostree-1, /usr/lib/ostree,
          /usr/lib/tmpfiles.d, /usr/libexec/libostee, og
          /usr/share/ostree/trusted.gpg.d
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="ostree-bin">
        <term><command>ostree</command></term>
        <listitem>
          <para>
            administrerer filsystemtrær
          </para>
          <indexterm zone="ostree ostree-bin">
            <primary sortas="b-ostree-bin">ostree</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="ostree-prepare-root">
        <term><command>ostree-prepare-root</command></term>
        <listitem>
          <para>
            endrer visningen av et montert rotfilsystem til en 
            ostree distribusjon
          </para>
          <indexterm zone="ostree ostree-prepare-root">
            <primary sortas="b-ostree-prepare-root">ostree-prepare-root</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="ostree-remount">
        <term><command>ostree-remount</command></term>
        <listitem>
          <para>
            forbereder roten for et filsystem
          </para>
          <indexterm zone="ostree ostree-remount">
            <primary sortas="b-ostree-remount">ostree-remount</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="rofiles-fuse">
        <term><command>rofiles-fuse</command></term>
        <listitem>
          <para>
            bruker Fuse til å lage en visning der 
            mapper og filer er uforanderlige
          </para>
          <indexterm zone="ostree rofiles-fuse">
            <primary sortas="b-rofiles-fuse">rofiles-fuse</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libostree-1">
        <term><filename class="libraryfile">libostree-1</filename></term>
        <listitem>
          <para>
            inneholder funksjoner for å administrere filsystemtrær
          </para>
          <indexterm zone="ostree libostree-1">
            <primary sortas="c-libostree-1">libostree-1</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
