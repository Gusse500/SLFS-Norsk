<sect1 id="w3m" xreflabel="w3m-&w3m-version;">
  <?dbhtml filename="w3m.html"?>


  <title>W3m-&w3m-version;</title>

  <indexterm zone="w3m">
    <primary sortas="a-W3m">W3m</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til W3m</title>

    <para><application>w3m</application> er både en terminalleser og en 
    tekstmodus WWW nettleser. Den kan brukes som en erstatning for BLFS TUI WWW 
    nettleserne med støtte for bilder og andre tagger og diverse.</para>

    <bridgehead renderas="sect3">Pakkeinformasjon</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>Nedlasting (HTTP): <ulink url="&w3m-download-http;"/></para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">W3m Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/gc.html">GC</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/x/imlib2.html">imlib2</ulink> og
      <ulink url="&blfs-svn;/x/x7lib.html">Xorg Biblioteker</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/x/gdk-pixbuf.html">gdk-pixbuf</ulink>,
      <ulink url="&blfs-svn;/general/gpm.html">GPM</ulink>, og
      <xref linkend="m17n"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av W3m</title>

    <para>Installer <application>w3m</application> ved å kjøre følgende 
      kommandoer:</para>

<screen><userinput>./configure --prefix=/usr          \
            --sysconfdir=/etc      \
            --enable-image=fb,x11  \
            --with-imagelib=imlib2 &amp;&amp;
make</userinput></screen>

    <para>Nå, som &root; bruker:</para>

<screen role="root"><userinput>make install &amp;&amp;
install -vDm644  doc/{HISTORY,READ*,keymap.*,menu.*,*.html} \
             -t  /usr/share/doc/w3m-&w3m-version;</userinput></screen>
  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para><parameter>--sysconfdir=/etc</parameter>: Denne parameteren legger 
    konfigurasjonsfilene i /etc.</para>

    <para><parameter>--enable-image=fb,x11</parameter>: Denne parameteren 
    aktiverer bildestøtte for framebufferen og X11.</para>

    <para><parameter>--with-imagelib=imlib2</parameter>: Denne parameteren 
    bygger mot Imlib2 bildebiblioteket for bildestøtte.</para>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>w3m og w3mman</seg>
        <seg>Ingen</seg>
        <seg>/usr/libexec/w3m,
             /usr/share/w3m, og
             /usr/share/doc/w3m-&w3m-version;</seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="w3m-prog">
        <term><command>w3m</command></term>
        <listitem>
          <para>er en tekstbasert nettleser og terminalleser.</para>
          <indexterm zone="w3m w3m-prog">
            <primary sortas="b-w3m">w3m</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="w3mman">
         <!-- Don't remove the extra space, it prevent a FOP warning. -->
        <term><command>w3mman</command> </term>
        <listitem>
          <para>er et grensesnitt til de nettbaserte referansehåndbøkene i
          <command>w3m</command>.</para>
          <indexterm zone="w3m w3mman">
            <primary sortas="b-w3mman">w3mman</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>
  </sect2>
