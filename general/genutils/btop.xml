<sect1 id="btop" xreflabel="BTOP++-&btop-version;">
  <?dbhtml filename="btop.html"?>

  <title>BTOP++-&btop-version;</title>

  <indexterm zone="btop">
    <primary sortas="a-btop">BTOP++</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til BTOP++</title>

    <para>
      BTOP++-pakken tilbyr et brukergrensesnitt (TUI)
      <footnote><para>
        Tekstbasert brukergrensesnitt.
      </para></footnote>
      systemmonitor, omtrent som <xref linkend="htop"/>. Denne pakken har 
      imidlertid enda flere funksjoner.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&btop-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">BTOP++ Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&arch-pkgs;/extra/x86_64/lowdown/">lowdown</ulink> og
      <ulink url="&arch-pkgs;/extra/x86_64/rocm-smi-lib/">ROCM-SMI-lib</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av BTOP++</title>

    <para>
      Installer BTOP++ ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make PREFIX=/usr install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
