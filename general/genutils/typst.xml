<sect1 id="typst" xreflabel="typst-&typst-version;">
  <?dbhtml filename="typst.html"?>

  <title>typst-&typst-version;</title>

  <indexterm zone="typst">
    <primary sortas="a-typst">typst</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til typst</title>

    <para>
      typst pakken tilbyr et kraftig og lettlært markupbasert 
      satsingssystem.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&typst-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">typst Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>

    <para role="required">
      <ulink url="&blfs-svn;/general/rust.html">rustc</ulink>
    </para>

    &build-use-internet;

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av typst</title>

    <para>
      Installer typst ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>OPENSSL_NO_VENDOR=true GEN_ARTIFACTS=../../target/artifacts/ \
cargo build -p typst-cli --release</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm755 target/release/typst -t /usr/bin/ &amp;&amp;
install -vDm644 target/artifacts/*.1 -t /usr/share/man/man1/</userinput></screen>

    <para>
      Hvis du ønsker å installere skallkompletteringer, utfør de relevante 
      kommandoene for skallet/skallene dine som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm644 target/artifacts/typst.bash    /usr/share/bash-completion/completions/typst
install -vDm644 target/artifacts/_typst     -t /usr/share/zsh/site-functions/
install -vDm644 target/artifacts/typst.fish -t /usr/share/fish/vendor_completions.d/</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <parameter>-p typst-cli</parameter>: Dette forteller 
      <command>cargo</command> å bare bygge typst-cli pakken.
    </para>

    <para>
      <envar>OPENSSL_NO_VENDOR=true</envar>: Dette hindrer byggesystemet i å 
      bruke den medsendte OpenSSL, men bruke systemets.
    </para>

    <para>
      <envar>GEN_ARTIFACTS=../../target/artifacts/</envar>: Dette setter mappen 
      for genererte artefakter som manualsider og 
      skallfullføringer.
    </para>

  </sect2>
