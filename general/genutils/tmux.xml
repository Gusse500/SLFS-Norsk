<sect1 id="tmux" xreflabel="tmux-&tmux-version;">
  <?dbhtml filename="tmux.html"?>

  <title>tmux-&tmux-version;</title>

  <indexterm zone="tmux">
    <primary sortas="a-tmux">tmux</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til tmux</title>

    <para>
      tmux pakken tilbyr en terminalmultiplekser 
      og et alternativ til <ulink
      url="&blfs-svn;/general/screen.html">Screen</ulink>.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&tmux-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">tmux Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/basicnet/libevent.html">libevent</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="libutempter"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av tmux</title>

    <para>
      Installer tmux ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <option>--enable-utempter</option>: Hvis du installerte <xref
      linkend="libutempter"/>, Bruk dette alternativet for å kunne oppdatere utmp.
    </para>

  </sect2>
  
