<sect1 id="jstest-sdl" xreflabel="jstest-sdl-&jstest-sdl-minor-version;">
  <?dbhtml filename="jstest-sdl.html"?>

  <title>jstest-sdl-&jstest-sdl-minor-version;</title>

  <indexterm zone="jstest-sdl">
    <primary sortas="a-jstest-sdl">jstest-sdl</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til jstest-sdl</title>

    <para>
      Pakken jstest-sdl tilbyr et program for testing av gamepad/joystick 
      innganger, som kan hjelpe med å tilordne kontrollere manuelt som 
      beskrevet i <xref linkend="m64plus-components"/>.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&jstest-sdl-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">jstest-sdl Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      &sdl2;
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av jstest-sdl</title>

    <para>
      Installer jstest-sdl ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>sed -i 's/\-ltinfo//g' Makefile &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm755 jstest-sdl -t /usr/bin/</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <command>sed -i 's/\-ltinfo//g' Makefile</command>: Denne kommandoen 
      unngår kobling mot et Ncurses bibliotek som ikke var 
      bygget i LFS.
    </para>

  </sect2>

