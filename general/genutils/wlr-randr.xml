  <sect2 role="package">
    <title>Introduksjon til wlr-randr</title>

    <para>
      Pakken wlr-randr tilbyr et verktøy for å administrere utdata fra en 
      Wayland kompositor. wlr-randr kan spørre etter skjerminformasjon og angi 
      skjermoppløsning og oppdateringsfrekvens.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&wlr-randr-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">wlr-randr Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/wayland.html">Wayland</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <xref linkend="scdoc"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av wlr-randr</title>

    <para>
      Installer wlr-randr ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup ..             \
      --prefix=/usr        \
      --buildtype=release &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

