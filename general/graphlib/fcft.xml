<sect1 id="fcft" xreflabel="fcft-&fcft-version;">
  <?dbhtml filename="fcft.html"?>


  <title>fcft-&fcft-version;</title>

  <indexterm zone="fcft">
    <primary sortas="a-fcft">fcft</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til fcft</title>

    <para>
      fcft pakken inneholder et bibliotek for lasting av 
      fonter og rasterisering av glyffer.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&fcft-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">fcft Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/fontconfig.html">fontconfig</ulink>,
      <ulink url="&blfs-svn;/general/freetype2.html">FreeType2</ulink>, og
      <ulink url="&blfs-svn;/general/pixman.html">Pixman</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/harfbuzz.html">HarfBuzz</ulink> og
      <xref linkend="tllist"/> (hvis den ikke er bygget, vil den bli lastet ned)
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="https://github.com/memononen/nanosvg">nanosvg</ulink>,
      <xref linkend="scdoc"/>, og
      <ulink url="&arch-pkgs;/extra/x86_64/utf8proc/">utf8proc</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av fcft</title>

    <para>
      Installer fcft ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

    <para>
      Hvis du bygde scdoc, gjør dokumentasjonsmappen 
      versjonert som &root; bruker:
    </para>

<screen remap="doc"
  role="root"><userinput>mv -v /usr/share/doc/fcft{,-&fcft-version;}</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          Ingen
        </seg>
        <seg>
          libfcft
        </seg>
        <seg>
          /usr/share/doc/fcft-3.3.1 og /usr/include/fcft
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="libfcft">
        <term><filename class="libraryfile">libfcft</filename></term>
        <listitem>
          <para>
            inneholder funksjoner for håndtering av fonter og glyffer
          </para>
          <indexterm zone="fcft libfcft">
            <primary sortas="c-libfcft">libfcft</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
