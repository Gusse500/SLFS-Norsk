  <?dbhtml filename="mksh.html"?>

  <title>mksh-&mksh-version;</title>

  <indexterm zone="mksh">
    <primary sortas="a-mksh">mksh</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til mksh</title>

    <para>
      mksh pakken inneholder MirBSD Korn Shell, som er et lite, raskt og 
      pålitelig skall som passer for både skripting og interaktiv bruk.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&mksh-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">mksh Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/postlfs/ed.html">Ed</ulink> (for 3 tester)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av mksh</title>

    <para>
      Installer mksh ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>sh Build.sh -r</userinput></screen>

    <para>
        For å teste resultatene, utsted <command>./mksh test.sh</command>.
    </para>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm755 mksh   -t /usr/bin/ &amp;&amp;
install -vDm644 mksh.1 -t /usr/share/man/man1/</userinput></screen>

  </sect2>

  <sect2 role="configuration">
    <title>Konfigurere mksh</title>

    <sect3><title>Konfigurasjonsinformasjon</title>

      <para>
        Som &root; bruker, oppdater <filename>/etc/shells</filename> for å 
        inkludere mksh skallet:
      </para>

<screen role="root"><userinput>cat &gt;&gt; /etc/shells &lt;&lt; "EOF"
<literal>/usr/bin/mksh</literal>
EOF</userinput></screen>

    </sect3>

  </sect2>

