<sect1 id="ksh" xreflabel="ksh-&ksh-version;">
  <?dbhtml filename="ksh.html"?>

  <title>ksh-&ksh-version;</title>

  <indexterm zone="ksh">
    <primary sortas="a-ksh">ksh</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til ksh</title>

    <para>
      Ksh pakken inneholder Korn Shell.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&ksh-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>
   
  </sect2>

  <sect2 role="installation">
    <title>Installasjon av ksh</title>

    <para>
      Installer ksh ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>bin/package make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>bin/package install /usr</userinput></screen>

  </sect2>

  <sect2 role="configuration">
    <title>Konfigurere ksh</title>

    <sect3><title>Konfigurasjonsinformasjon</title>

      <para>
        Som &root; bruker, oppdater <filename>/etc/shells</filename> til å 
        inkludere navnene på Korn shell programmene:
      </para>

<screen role="root"><userinput>cat &gt;&gt; /etc/shells &lt;&lt; "EOF"
<literal>/usr/bin/ksh</literal>
EOF</userinput></screen>

    </sect3>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          ksh og shcomp
        </seg>
        <seg>
          libast, libcmd, libdll, og libshell
        </seg>
        <seg>
          /usr/include/ast og /usr/share/fun
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="ksh-bin">
        <term><command>ksh</command></term>
        <listitem>
          <para>
            er Korn Shell
          </para>
          <indexterm zone="ksh ksh-bin">
            <primary sortas="b-ksh-bin">ksh</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="shcomp">
        <term><command>shcomp</command></term>
        <listitem>
          <para>
            kompilerer et skallskript
          </para>
          <indexterm zone="ksh shcomp">
            <primary sortas="b-shcomp">shcomp</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libast">
        <term><filename class="libraryfile">libast</filename></term>
        <listitem>
          <para>
            er AT&amp;T Programvareteknologibibliotek
          </para>
          <indexterm zone="ksh libast">
            <primary sortas="c-libast">libast</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libcmd">
        <term><filename class="libraryfile">libcmd</filename></term>
        <listitem>
          <para>
            inneholder <command>ksh</command> lastbare innebygde elementer
          </para>
          <indexterm zone="ksh libcmd">
            <primary sortas="c-libcmd">libcmd</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libdll">
        <term><filename class="libraryfile">libdll</filename></term>
        <listitem>
          <para>
            inneholder innpakninger rundt dlopen() og lignende funksjoner
          </para>
          <indexterm zone="ksh libdll">
            <primary sortas="c-libdll">libdll</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libshell">
        <term><filename class="libraryfile">libshell</filename></term>
        <listitem>
          <para>
            inneholder <command>ksh</command> bibliotekgrensesnitt
          </para>
          <indexterm zone="ksh libshell">
            <primary sortas="c-libshell">libshell</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>  

</sect1>
