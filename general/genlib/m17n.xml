<sect1 id="m17n" xreflabel="m17n-&m17n-version;">
  <?dbhtml filename="m17n.html"?>

  <title>m17n-&m17n-version;</title>

  <indexterm zone="m17n">
    <primary sortas="a-m17n">m17n</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til m17n</title>

    <para>
      m17n pakken tilbyr et bibliotek for flerspråklighet av 
      applikasjoner.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&m17n-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd database:
          <ulink url="https://download.savannah.nongnu.org/releases/m17n/m17n-db-&m17n-db-version;.tar.gz"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">m17n Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="anthy"/>,
      <ulink url="&blfs-svn;/general/aspell.html">Aspell</ulink>,
      <ulink url="&blfs-svn;/general/fontconfig.html">Fontconfig</ulink>,
      <ulink url="&blfs-svn;/general/freetype.html">FreeType</ulink>,
      <ulink url="&blfs-svn;/general/fribidi.html">FriBidi</ulink>,
      <ulink url="&blfs-svn;/general/libxml2.html">libxml2</ulink>, og
      <ulink url="&blfs-svn;/x/x7lib.html">Xorg Biblioteker</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="https://libgd.github.io/">LibGD</ulink> og
      <ulink url="https://github.com/netkawai/libotf">libotf</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av m17n</title>

    <para>
      Først installerer du m17n databasen ved å kjøre 
      følgende kommandoer:
    </para>

<screen><userinput>tar -xvf ../m17n-db-&m17n-db-version;.tar.gz &amp;&amp;
cd m17n-db-&m17n-db-version; &amp;&amp;
./configure --prefix=/usr &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker, installer databasen:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

    <para>
      Installer deretter m17n ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>cd .. &amp;&amp;
./configure --prefix=/usr --disable-static &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          m17n-conv, m17n-date, m17n-db, m17n-dump, m17n-edit, og m17n-view
        </seg>
        <seg>
          libm17n-core, libm17n-flt, libm17n-gui, og libm17n
        </seg>
        <seg>
          /usr/lib/m17n og /usr/share/m17n
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="m17n-conv">
        <term><command>m17n-conv</command></term>
        <listitem>
          <para>
            konverterer filer mellom kodinger
          </para>
          <indexterm zone="m17n m17n-conv">
            <primary sortas="b-m17n-conv">m17n-conv</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="m17n-date">
        <term><command>m17n-date</command></term>
        <listitem>
          <para>
            viser systemets dato og klokkeslett på mange språk
          </para>
          <indexterm zone="m17n m17n-date">
            <primary sortas="b-m17n-date">m17n-date</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="m17n-db">
        <term><command>m17n-db</command></term>
        <listitem>
          <para>
            skriver ut informasjon om m17n databasen
          </para>
          <indexterm zone="m17n m17n-db">
            <primary sortas="b-m17n-db">m17n-db</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="m17n-dump">
        <term><command>m17n-dump</command></term>
        <listitem>
          <para>
            dumper tekst som en PNG bildefil
          </para>
          <indexterm zone="m17n m17n-dump">
            <primary sortas="b-m17n-dump">m17n-dump</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="m17n-edit">
        <term><command>m17n-edit</command></term>
        <listitem>
          <para>
            viser en fil i et vindu og lar brukere redigere den
          </para>
          <indexterm zone="m17n m17n-edit">
            <primary sortas="b-m17n-edit">m17n-edit</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="m17n-view">
        <term><command>m17n-view</command></term>
        <listitem>
          <para>
            viser en fil i et vindu
          </para>
          <indexterm zone="m17n m17n-view">
            <primary sortas="b-m17n-view">m17n-view</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libm17n-core">
        <term><filename class="libraryfile">libm17n-core</filename></term>
        <listitem>
          <para>
            er kjernebiblioteket til m17n
          </para>
          <indexterm zone="m17n libm17n-core">
            <primary sortas="c-libm17n-core">libm17n-core</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libm17n-flt">
        <term><filename class="libraryfile">libm17n-flt</filename></term>
        <listitem>
          <para>
            er m17n biblioteket for fontlayouttabeller
