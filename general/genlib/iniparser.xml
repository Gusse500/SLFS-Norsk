        </seg>
        <seg>
          /usr/include/iniparser og /usr/lib/cmake/iniparser
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
