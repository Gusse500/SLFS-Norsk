<sect1 id="cjson" xreflabel="cJSON-&cjson-version;">
  <?dbhtml filename="cjson.html"?>

  <title>cJSON-&cjson-version;</title>

  <indexterm zone="cjson">
    <primary sortas="a-cjson">cJSON</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til cJSON</title>

    <para>
      cJSON pakken (ikke å forveksle med JSON-C som oppfyller samme formål, 
      men med et annet API) tilbyr et lett JSON parserbibliotek 
      i C.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&cjson-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="&dl-root;/cJSON/cJSON-&cjson-version;-upstream_fixes-1.patch"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">cJSON Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av cJSON</title>

    <para>
      Installer en oppdatering for å fikse flere sikkerhetsproblemer og andre problemer:
    </para>

<screen><userinput remap="pre">patch -Np1 -i ../cJSON-&cjson-version;-upstream_fixes-1.patch</userinput></screen>

    <para>
      Installer cJSON ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -G Ninja .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

