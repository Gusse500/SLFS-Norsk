<sect1 id="libx86emu" xreflabel="libx86emu-&libx86emu-version;">
  <?dbhtml filename="libx86emu.html"?>

  <title>libx86emu-&libx86emu-version;</title>

  <indexterm zone="libx86emu">
    <primary sortas="a-libx86emu">libx86emu</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libx86emu</title>

    <para>
      Pakken libx86emu inneholder et bibliotek for emulering av x86 kall, som 
      ofte brukes til å jobbe med fastvare og håndtere VBE kall.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libx86emu-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libx86emu</title>

    <para>
      Installer libx86emu ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>make VERSION=&libx86emu-version; \
     MAJOR_VERSION=&libx86emu-major; \
     shared</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make VERSION=&libx86emu-version; \
     MAJOR_VERSION=&libx86emu-major; \
     LIBDIR=/usr/lib \
     install</userinput></screen>

  </sect2>

