<sect1 id="libime" xreflabel="libime-&libime-version;">
  <?dbhtml filename="libime.html"?>

  <title>libime-&libime-version;</title>

  <indexterm zone="libime">
    <primary sortas="a-libime">libime</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libime</title>

    <para>
      libime pakken tilbyr et bibliotek med støttefunksjoner for 
      implementering av generiske inndatametoder.
    </para>

    &build-use-internet;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libime-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd undermodul:
          <ulink url="https://github.com/kpu/kenlm/archive/&libime-kenlm;/kenlm-&libime-kenlm;.tar.gz"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libime Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/boost.html">Boost</ulink>,
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>,
      &ecm;,
      og <xref linkend="fcitx5"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/general/doxygen.html">doxygen</ulink> (for å bygge 
      dokumentasjonen)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libime</title>

    <para>
      Pakk ut kenlm undermodulen på riktig sted:
    </para>

<screen><userinput>tar -xf ../kenlm-&libime-kenlm;.tar.gz &amp;&amp;
mv kenlm-* -T src/libime/core/kenlm</userinput></screen>

    <para>
      Installer libime ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -D CMAKE_SKIP_INSTALL_RPATH=ON \
      -D BUILD_SHARED_LIBS=ON        \
      -D ENABLE_TEST=OFF             \
      -Wno-dev .. &amp;&amp;

make</userinput></screen>

    <para>
      Hvis du har sendt <option>-D ENABLE_DOC=ON</option> parameteren til CMake,
      bygg dokumentasjonen ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>make doc</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

    <para>
      Hvis du har bygget dokumentasjonen, installer den som &root; bruker:
    </para>

<!-- install doesn't support recursive copy and there's no doc install
target... ugh -->
<screen role="root"><userinput>install -vdm755   /usr/share/doc/libime-&libime-version; &amp;&amp;
cp -rv doc/html/* /usr/share/doc/libime-&libime-version;</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &cmake-skip-install-rpath;

    <para>
      <parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Dette sikrer at delte 
      biblioteker bygges.
    </para>

    <para>
      <option>-D ENABLE_DOC=ON</option>: Bruk denne bryteren hvis du vil 
      bygge dokumentasjonen (krever doxygen).
    </para>

  </sect2>

  <sect2 role="content">
