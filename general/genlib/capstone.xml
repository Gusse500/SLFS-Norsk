<sect1 id="capstone" xreflabel="Capstone-&capstone-version;">
  <?dbhtml filename="capstone.html"?>


  <title>Capstone-&capstone-version;</title>

  <indexterm zone="capstone">
    <primary sortas="a-capstone">Capstone</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Capstone</title>

    <para>
      Capstone pakken tilbyr et demonterrammeverk.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&capstone-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Capstone Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>
    </para>

    <note><para>
      <command>make</command> kan brukes til å installere pakken, men det vil 
      ikke tilby filer for å finne Capstone via CMake. CMake må brukes til å 
      installere disse filene, så bruk av CMake anbefales på det sterkeste.
    </para></note>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Capstone</title>

    <para>
      Installer Capstone ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D BUILD_STATIC_LIBS=OFF     \
      -D BUILD_SHARED_LIBS=ON      \
      -W no-author -G Ninja ..    &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

