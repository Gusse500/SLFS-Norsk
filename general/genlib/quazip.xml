<sect1 id="quazip" xreflabel="QuaZip-&quazip-version;">
  <?dbhtml filename="quazip.html"?>

  <title>QuaZip-&quazip-version;</title>

  <indexterm zone="quazip">
    <primary sortas="a-quazip">QuaZip</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til QuaZip</title>

    <para>
      QuaZip pakken tilbyr en C++ versjon av minizip for Qt. Den bruker ikke 
      <xref linkend="minizip"/>. Den har sin egen spesialkopi.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&quazip-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">QuaZip Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink> og
      <ulink url="&blfs-svn;/x/qt6.html">Qt-6</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av QuaZip</title>

    <para>
      Installer QuaZip ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -G Ninja .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          Ingen
        </seg>
        <seg>
          libquazip&quazip-major;-qt6
        </seg>
        <seg>
          /usr/include/QuaZip-Qt6-&quazip-version; og
          /usr/lib/cmake/QuaZip-Qt6-&quazip-version;
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="libquazip">
