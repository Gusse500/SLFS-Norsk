        <listitem>
          <para>
            tilbyr funksjoner for håndtering av ZIP filer
          </para>
          <indexterm zone="quazip libquazip">
            <primary sortas="c-libquazip">libquazip</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

