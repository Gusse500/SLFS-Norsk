<sect1 id="libutempter" xreflabel="libutempter-&libutempter-version;">
  <?dbhtml filename="libutempter.html"?>

  <title>libutempter-&libutempter-version;</title>

  <indexterm zone="libutempter">
    <primary sortas="a-libutempter">libutempter</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libutempter</title>

    <para>
      libutempter pakken er et bibliotek som lar ikke-privilegerte 
      apper skrive utmp informasjon.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libutempter-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="&dl-root;/libutempter/libutempter-&libutempter-version;-unbreak-reinstall.patch"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libutempter</title>

    <para>
      Installer libutempter ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>patch -Np1 -i ../libutempter-1.2.3-unbreak-reinstall.patch &amp;&amp;
cd libutempter &amp;&amp;
make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installert Program</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installert Mappe</segtitle>

      <seglistitem>
        <seg>
          utempter
        </seg>
        <seg>
          libutempter
        </seg>
        <seg>
          /usr/lib/utempter
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="utempter">
        <term><command>utempter</command></term>
        <listitem>
          <para>
            er et privilegert hjelpeprogram for utmp/wtmp oppdateringer
          </para>
          <indexterm zone="libutempter utempter">
            <primary sortas="b-utempter">utempter</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libutempter-bin">
        <term><filename class="libraryfile">libutempter</filename></term>
        <listitem>
          <para>
            inneholder grensesnittet til utempter biblioteket
          </para>
          <indexterm zone="libutempter libutempter-bin">
            <primary sortas="c-libutempter">libutempter</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
