<sect1 id="libzmq" xreflabel="libzmq-&libzmq-version;">
  <?dbhtml filename="libzmq.html"?>

  <title>libzmq-&libzmq-version;</title>

  <indexterm zone="libzmq">
    <primary sortas="a-libzmq">libzmq</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libzmq</title>

    <para>
      Pakken libzmq, eller ZeroMQ/0MQ, tilbyr et bibliotek for å utvide 
      vanlige socket grensesnitt, og gir abstraksjoner for 
      meldinger.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libzmq-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libzmq Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/libunwind.html">libunwind</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/general/asciidoctor.html">asciidoctor</ulink>,
      <ulink url="&blfs-svn;/general/valgrind.html">Valgrind</ulink>, og
      <ulink url="&blfs-svn;/pst/xmlto.html">xmlto</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libzmq</title>

    <para>
      Installer libzmq ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>./autogen.sh &amp;&amp;
./configure --prefix=/usr --disable-static &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &static-libraries;

  </sect2>

