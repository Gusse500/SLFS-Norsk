<sect1 id="tomlplusplus" xreflabel="toml++-&tomlplusplus-version;">
  <?dbhtml filename="tomlplusplus.html"?>

  <title>toml++-&tomlplusplus-version;</title>

  <indexterm zone="tomlplusplus">
    <primary sortas="a-toml++">toml++</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til toml++</title>

    <para>
      Pakken toml++ er en TOML konfigurasjonsanalysator for C++.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&tomlplusplus-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">toml++ Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av toml++</title>

    <para>
      Installer toml++ ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>
    <para><option>-D generate_cmake_config=false</option>: Dette alternativet 
    deaktiverer avhengighet av CMake, men genererer derfor ikke CMake 
    find_package filer som noen byggesystemer krever.</para>
  </sect2>

