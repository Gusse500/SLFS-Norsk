<sect1 id="libzip" xreflabel="libzip-&libzip-version;">
  <?dbhtml filename="libzip.html"?>


  <title>libzip-&libzip-version;</title>

  <indexterm zone="libzip">
    <primary sortas="a-libzip">libzip</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libzip</title>

    <para>
      libzip pakken inneholder et bibliotek og verktøy for håndtering av zip 
      arkiver.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libzip-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libzip Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/postlfs/gnutls.html">GnuTLS</ulink> og
      <xref linkend="mbedtls"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libzip</title>

    <para>
      Installer libzip ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -D CMAKE_SKIP_INSTALL_RPATH=ON \
      -G Ninja .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &cmake-skip-install-rpath;

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installert Mappe</segtitle>

      <seglistitem>
        <seg>
          zipcmp,
          zipmerge, og
          ziptool
        </seg>
        <seg>
          libzip
        </seg>
        <seg>
          /usr/lib/cmake/libzip
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="zipcmp">
        <term><command>zipcmp</command></term>
        <listitem>
          <para>
            sammenligner innholdet i zip arkiver
          </para>
          <indexterm zone="libzip zipcmp">
            <primary sortas="b-zipcmp">zipcmp</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="zipmerge">
        <term><command>zipmerge</command></term>
        <listitem>
          <para>
            slår sammen zip arkiver
          </para>
          <indexterm zone="libzip zipmerge">
            <primary sortas="b-zipmerge">zipmerge</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="ziptool">
        <term><command>ziptool</command></term>
        <listitem>
          <para>
            endrer zip arkiver
          </para>
          <indexterm zone="libzip ziptool">
            <primary sortas="b-ziptool">ziptool</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libzip-lib">
        <term><filename class="libraryfile">libzip</filename></term>
        <listitem>
          <para>
            inneholder funksjoner som kan endre og sammenligne zip arkiver
          </para>
          <indexterm zone="libzip libzip-lib">
            <primary sortas="c-libzip-lib">libzip</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
