<sect1 id="sdl2_net" xreflabel="SDL2_net-&sdl2_net-version;">
  <?dbhtml filename="sdl2_net.html"?>
	
  <title>SDL2_net-&sdl2_net-version;</title>

  <indexterm zone="sdl2_net">
    <primary sortas="a-sdl2_net">SDL2_net</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til SDL2_net</title>

    <para>
      Pakken sdl2_net tilbyr et nettverksbibliotek for 
      flere plattformer.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&sdl2_net-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">SDL2_net Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/multimedia/sdl2.html">SDL2</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av SDL2_net</title>

    <para>
      Installer SDL2_net ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr     \
            --disable-static  \
            --disable-sdltest \
            --disable-examples &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &static-libraries;

    <para>
      <parameter>--disable-sdltest --disable-examples</parameter>: Disse 
      parameterne deaktiverer kobling mot et bibliotek som ble slettet i <ulink
      url="&blfs-svn;/multimedia/sdl2.html">SDL2</ulink>.
    </para>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installert Bibliotek</segtitle>
      <segtitle>Installert Mappe</segtitle>

      <seglistitem>
        <seg>
          Ingen
        </seg>
        <seg>
          libSDL2_net
        </seg>
        <seg>
          /usr/lib/cmake/SDL2_net
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="libsdl2_net">
        <term><filename class="libraryfile">libSDL2_net</filename></term>
        <listitem>
          <para>
            inneholder nettverksfunksjoner
          </para>
          <indexterm zone="sdl2_net libsdl2_net">
            <primary sortas="c-libsdl2_net">libSDL2_net</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

