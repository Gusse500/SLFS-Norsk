<sect1 id="re2" xreflabel="re2-&re2-version;">
  <?dbhtml filename="re2.html"?>


  <title>re2-&re2-version;</title>

  <indexterm zone="re2">
    <primary sortas="a-re2">re2</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til re2</title>

    <para>
      re2 pakken tilbyr et bibliotek med regulære uttrykk.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&re2-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">re2 Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink> og
      <ulink url="&blfs-svn;/general/abseil-cpp.html">Abseil-cpp</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av re2</title>

    <para>
      Installer re2 ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D BUILD_SHARED_LIBS=ON      \
      -G Ninja .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Denne parameteren bygger 
      delte versjoner av bibliotekene som tilbys av denne pakken i stedet for 
      statiske biblioteker.
    </para>

  </sect2>

