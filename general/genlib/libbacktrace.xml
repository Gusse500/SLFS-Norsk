<sect1 id="libbacktrace" xreflabel="libbacktrace-&libbacktrace-minor;">
  <?dbhtml filename="libbacktrace.html"?>

  <title>libbacktrace-&libbacktrace-minor;</title>

  <indexterm zone="libbacktrace">
    <primary sortas="a-libbacktrace">libbacktrace</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libbacktrace</title>

    <para>
      Pakken libbacktrace tilbyr et bibliotek som produserer tilbakesporinger 
      med symbolsk informasjon.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libbacktrace-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="&dl-root;/libbacktrace/libbacktrace-&libbacktrace-minor;-pkgconfig-1.patch"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libbacktrace</title>

    <para>
      Installer en oppdatering slik at en Pkg-config fil genereres for biblioteket:
    </para>

<screen remap="pre"><userinput>patch -Np1 -i ../libbacktrace-&libbacktrace-minor;-pkgconfig-1.patch</userinput></screen>

    <para>
      Regenerer autoconf filene for å sikre at de er nye:
    </para>

    <screen remap="pre"><userinput>autoreconf -fi</userinput></screen>

    <para>
      Installer libbacktrace ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr    \
            --disable-static \
            --enable-shared &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

    <screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &static-libraries;

    <para>
      <parameter>--enable-shared</parameter>: Dette alternativet forteller 
      byggesystemet at det skal bygge delte biblioteker, ettersom bygging av 
      dem er deaktivert som standard.
    </para>

  </sect2>

