<sect1 id="pugixml" xreflabel="pugixml-&pugixml-version;">
  <?dbhtml filename="pugixml.html"?>


  <title>pugixml-&pugixml-version;</title>

  <indexterm zone="pugixml">
    <primary sortas="a-pugixml">pugixml</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til pugixml</title>

    <para>
      pugixml pakken tilbyr en lettvekst XML analysator for C++.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&pugixml-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">pugixml Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av pugixml</title>

    <para>
      Installer pugixml ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr   \
      -D CMAKE_BUILD_TYPE=Release    \
      -D CMAKE_SKIP_INSTALL_RPATH=ON \
      -D BUILD_SHARED_LIBS=ON        \
      -G Ninja .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &cmake-skip-install-rpath;

    <para>
      <parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Denne parameteren tvinger 
      byggesystemet til å bygge delte biblioteker i stedet for statiske.
    </para>

  </sect2>

