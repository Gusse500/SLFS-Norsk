<sect1 id="libdatachannel" xreflabel="libdatachannel-&libdatachannel-version;">
  <?dbhtml filename="libdatachannel.html"?>

  <title>libdatachannel-&libdatachannel-version;</title>

  <indexterm zone="libdatachannel">
    <primary sortas="a-libdatachannel">libdatachannel</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libdatachannel</title>

    <para>
      Pakken libdatachannel tilbyr et WebRTC nettverksbibliotek.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&libdatachannel-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd undermodul:
          <ulink url="https://github.com/SergiusTheBest/plog/archive/&libdatachannel-plog;.tar.gz"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Påkrevd undermodul:
          <ulink url="https://github.com/sctplab/usrsctp/archive/&libdatachannel-usrsctp;.tar.gz"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libdatachannel Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/cmake.html">CMake</ulink>
    </para>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <xref linkend="libjuice"/> og
      <xref linkend="libsrtp"/>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/postlfs/gnutls.html">GnuTLS</ulink> og
      <xref linkend="nlohmann-json"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libdatachannel</title>

    <para>
      Pakk først ut undermodulene:
    </para>

<screen><userinput>tar -xf ../&libdatachannel-plog;.tar.gz &amp;&amp;
tar -xf ../&libdatachannel-usrsctp;.tar.gz &amp;&amp;

mv -T plog-*    deps/plog &amp;&amp;
mv -T usrsctp-* deps/usrsctp</userinput></screen>

    <para>
      Installer libdatachannel ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr        \
      -D CMAKE_BUILD_TYPE=Release         \
      -D CMAKE_SKIP_INSTALL_RPATH=ON      \
      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -D USE_GNUTLS=0                     \
      -D USE_NICE=0                       \
      -D USE_SYSTEM_JUICE=1               \
      -D USE_SYSTEM_SRTP=1                \
      -D NO_EXAMPLES=1                    \
      -D NO_TESTS=1                       \
      -Wno-dev -G Ninja .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>
  
  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &cmake-skip-install-rpath;

    <para>
      <parameter>-D CMAKE_POLICY_VERSION_MINIMUM=3.5</parameter>: Dette tillater 
      bygging med nyere CMake versjoner.
    </para>

    <para>
      <parameter>-D USE_GNUTLS=0</parameter>: Dette deaktiverer bygging mot den 
      valgfrie GnuTLS.
    </para>

    <para>
      <parameter>-D USE_NICE=0</parameter>: Dette sikrer at <xref 
      linkend="libjuice"/> brukes i stedet for en pakke som ikke er i denne boken.
    </para>

    <para>
      <parameter>-D USE_SYSTEM_JUICE=1</parameter>: Dette lenker mot 
      systeminstallerte <xref linkend="libjuice"/>.
    </para>

    <para>
      <parameter>-D USE_SYSTEM_SRTP=1</parameter>: Dette lenker mot 
      systeminstallerte <xref linkend="libsrtp"/>.
    </para>

    <para>
      <parameter>-D NO_EXAMPLES=1</parameter>: Dette deaktiverer bygging av eksempler.
    </para>

    <para>
      <parameter>-D NO_TESTS=1</parameter>: Dette deaktiverer bygging av tester.
    </para>

  </sect2>

