<sect1 id="fuse2" xreflabel="Fuse2-&fuse2-version;">
  <?dbhtml filename="fuse2.html"?>

  <title>Fuse2-&fuse2-version;</title>

  <indexterm zone="fuse2">
    <primary sortas="a-fuse2">Fuse2</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Fuse2</title>

    <para>
      FUSE, eller Filesystem in Userspace, lar brukerområdeprogrammer opprette 
      virtuelle filsystemer. Dette er en veldig nyttig teknologi, og den 
      nåværende Fuse versjonen er hovedversjon 3. Fuse2 brukes derimot fortsatt 
      av AppImages som er avhengige av denne teknologien. Du kan pakke ut 
      AppImages som du ønsker, noe som ville omgå dette kravet, men andre velger 
      å bare installere Fuse2 og kjøre AppImages direkte.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&fuse2-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <!-- As required -->
    <bridgehead renderas="sect3">Ytterligere Nedlastinger</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Påkrevd oppdatering:
          <ulink url="https://gitlab.archlinux.org/archlinux/packaging/packages/fuse2/-/raw/main/conditionally-define-closefrom.patch"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="kernel" id="fuse2-kernel">
    <title>Kjernekonfigurasjon</title>

    <para>
      Aktiver følgende alternativer i kjernekonfigurasjonen og kompiler kjernen 
      på nytt om nødvendig:
    </para>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="fuse2-kernel.xml"/>


    <indexterm zone="fuse2 fuse2-kernel">
      <primary sortas="d-fuse2">Fuse2</primary>
    </indexterm>
  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Fuse2</title>

    <para>
      Først installerer du en oppdatering for å fikse kompatibiliteten med 
      glibc-2.34 og nyere, og regenererer <filename>configure</filename> skriptet:
    </para>

<screen><userinput>patch -Np1 -i ../conditionally-define-closefrom.patch &amp;&amp;
autoreconf -i -I/usr/share/gettext/m4</userinput></screen>

    <para>
      Installer Fuse2 ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr --disable-static \
         INIT_D_PATH=/tmp/init.d &amp;&amp;

make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install &amp;&amp;

rm -rf  /tmp/init.d &amp;&amp;

install -vDm644 doc/{how-fuse-works,kernel.txt} \
        -t /usr/share/doc/fuse-&fuse2-version;/</userinput></screen>

  </sect2>

  <sect2 role="configuration">
    <title>Konfigurere Fuse2</title>

    <para>
      Noen alternativer angående monteringsretningslinjer kan angis i filen
      <filename>/etc/fuse.conf</filename>. For å installere filen, kjør 
      følgende kommando som &root; bruker:
    </para>

<screen role="root"><userinput>cat &gt; /etc/fuse.conf &lt;&lt; "EOF"
<literal># Set the maximum number of FUSE mounts allowed to non-root users.
# The default is 1000.
#
#mount_max = 1000

# Allow non-root users to specify the 'allow_other' or 'allow_root'
# mount options.
#
#user_allow_other</literal>
EOF</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Innhold</title>

    <segmentedlist>
      <segtitle>Installerte Programmer</segtitle>
      <segtitle>Installerte Biblioteker</segtitle>
      <segtitle>Installerte Mapper</segtitle>

      <seglistitem>
        <seg>
          fusermount, mount.fuse, og ulockmgr_server
        </seg>
        <seg>
          libfuse og libulockmgr
        </seg>
        <seg>
          /usr/include/fuse og /usr/share/doc/fuse-&fuse2-version;
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Korte Beskrivelser</bridgehead>
      <?dbfo list-presentation="list"?>
      <?dbhtml list-presentation="table"?>

      <varlistentry id="fusermount">
        <term><command>fusermount</command></term>
        <listitem>
          <para>
            er et suid root program for å montere og avmontere 
            Fuse2 filsystemer
          </para>
          <indexterm zone="fuse2 fusermount">
            <primary sortas="b-fusermount">fusermount</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="mount.fuse">
        <term><command>mount.fuse</command></term>
        <listitem>
          <para>
            er kommandoen <command>mount</command> kaller for å montere et 
            Fuse2 filsystem
          </para>
          <indexterm zone="fuse2 mount.fuse">
            <primary sortas="b-mount.fuse">mount.fuse</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="ulockmgr_server">
        <term><command>ulockmgr_server</command></term>
        <listitem>
          <para>
            er låseadministrator for brukerområde serveren for Fuse2 filsystemer
          </para>
          <indexterm zone="fuse2 ulockmgr_server">
            <primary sortas="b-ulockmgr_server">ulockmgr_server</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libfuse">
        <term><filename class="libraryfile">libfuse</filename></term>
        <listitem>
          <para>
            inneholder Fuse2 API funksjoner
          </para>
          <indexterm zone="fuse2 libfuse">
            <primary sortas="c-libfuse">libfuse</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libulockmgr">
        <term><filename class="libraryfile">libulockmgr</filename></term>
        <listitem>
          <para>
            starter <command>ulockmgr_server</command> og hjelper med 
            utførelsen
          </para>
          <indexterm zone="fuse2 libulockmgr">
            <primary sortas="c-libulockmgr">libulockmgr</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
