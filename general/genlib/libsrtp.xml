<sect1 id="libsrtp" xreflabel="libsrtp-&libsrtp-version;">
  <?dbhtml filename="libsrtp.html"?>

  <title>libsrtp-&libsrtp-version;</title>

  <indexterm zone="libsrtp">
    <primary sortas="a-libsrtp">libsrtp</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libsrtp</title>

    <para>
      libsrtp pakken tilbyr funksjoner for Secure Realtime Transport Protocol, 
      eller SRTP.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting (HTTP): <ulink url="&libsrtp-download-http;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">libsrtp Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Anbefalt</bridgehead>
    <para role="recommended">
      <ulink url="&blfs-svn;/general/nspr.html">NSPR</ulink> og
      <ulink url="&blfs-svn;/postlfs/nss.html">NSS</ulink>
    </para>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/general/doxygen.html">doxygen</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libsrtp</title>

    <para>
      Installer libsrtp ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr                  \
            --buildtype=release            \
            -D crypto-library=nss          \
            -D crypto-library-kdf=disabled \
            .. &amp;&amp;

ninja</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    &meson-buildtype-release;

  </sect2>

