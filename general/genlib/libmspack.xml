<sect1 id="libmspack" xreflabel="libmspack-&libmspack-version;">
  <?dbhtml filename="libmspack.html"?>

  <title>libmspack-&libmspack-version;</title>

  <indexterm zone="libmspack">
    <primary sortas="a-libmspack">libmspack</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libmspack</title>

    <para>
      Pakken libmspack inneholder et bibliotek som håndterer noen 
      Microsoft komprimeringsformater som CAB, CHM og HLP. Den 
      tilbyr også <command>cabextract</command> som pakker ut 
      Microsofts kabinettfiler.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libmspack-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libmspack</title>

    <para>
      Installer libmspack ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>cd libmspack                                &amp;&amp;
autoreconf -fi                              &amp;&amp;
./configure --prefix=/usr --disable-static  &amp;&amp;
make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

    <para>
      Nå installer <command>cabextract</command> programmet ved å kjøre 
      følgende kommandoer:
    </para>

<screen><userinput>cd ../cabextract                            &amp;&amp;
autoreconf -fi -I/usr/share/gettext/m4      &amp;&amp;
./configure --prefix=/usr                    \
            --disable-static                 \
            --with-external-libmspack=yes   &amp;&amp;
make</userinput></screen>

    <para>
      Nå som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

