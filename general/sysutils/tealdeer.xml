<sect1 id="tealdeer" xreflabel="tealdeer-&tealdeer-version;">
  <?dbhtml filename="tealdeer.html"?>

  <title>tealdeer-&tealdeer-version;</title>

  <indexterm zone="tealdeer">
    <primary sortas="a-tealdeer">tealdeer</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til tealdeer</title>

    <para>
      Tealdeer pakken gir et raskt
      <command>tldr</command> program som er et alternativ til
      <command>man</command>. Den har som mål å være mer konsis, tilgjengelig 
      og enkel enn det som tilbys av de fleste manualsider.
    </para>

    &build-use-internet;

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&tealdeer-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">tealdeer Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Påkrevd</bridgehead>
    <para role="required">
      <ulink url="&blfs-svn;/general/rust.html">Rustc</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av tealdeer</title>
    <para>
      Installer tealdeer ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>cargo build --release</userinput></screen>

    <para>
      For å teste resultatene, utsted: <command>cargo test --release</command>.
    </para>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>install -vDm755 target/release/tldr -t /usr/bin/</userinput></screen>

    <para>
      Last ned nå sidebufferen (dette må gjøres for hver bruker):
    </para>

<screen><userinput>tldr --update</userinput></screen>

  </sect2>

