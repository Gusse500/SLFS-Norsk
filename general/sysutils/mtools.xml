<sect1 id="mtools" xreflabel="Mtools-&mtools-version;">
  <?dbhtml filename="mtools.html"?>

  <title>Mtools-&mtools-version;</title>

  <indexterm zone="mtools">
    <primary sortas="a-mtools">Mtools</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til Mtools</title>

    <para>
      Mtools pakken inneholder et sett med verktøy for å få tilgang til MD-DOS 
      diskinnhold uten å montere disken.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&mtools-download;"/>
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Mtools Avhengigheter</bridgehead>

    <bridgehead renderas="sect4">Valgfri</bridgehead>
    <para role="optional">
      <ulink url="&blfs-svn;/x/x7lib.html">Xorg Libraries</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av Mtools</title>

    <para>
      Installer Mtools ved å kjøre følgende kommandoer:
    </para>

<screen><userinput>./configure --prefix=/usr --disable-floppyd &amp;&amp;
make</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Parameterforklaringer</title>

    <para>
      <parameter>--disable-floppyd</parameter>: Deaktiverer bygging av diskett 
      daemonen, som krever Xorg bibliotekene. Hvis du installerte disse 
      bibliotekene, kan du fjerne denne parameteren.
    </para>

  </sect2>

