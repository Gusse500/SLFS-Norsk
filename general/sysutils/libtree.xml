<sect1 id="libtree" xreflabel="libtree-&libtree-version;">
  <?dbhtml filename="libtree.html"?>

  <title>libtree-&libtree-version;</title>

  <indexterm zone="libtree">
    <primary sortas="a-libtree">libtree</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introduksjon til libtree</title>

    <para>
      libtree er et verktøy for å vise det 
      delte bibliotekavhengighetstreet til en binærfil.
    </para>

    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Nedlasting: <ulink url="&libtree-download;"/>
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Installasjon av libtree</title>

    <para>
      Installer libtree ved å kjøre følgende 
      kommandoer:
    </para>

<screen><userinput>make PREFIX=/usr</userinput></screen>

    <para>
      Nå, som &root; bruker:
    </para>

<screen role="root"><userinput>make PREFIX=/usr install</userinput></screen>

  </sect2>

